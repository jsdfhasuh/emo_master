        {
          "nodeId": "mask",
          "kind": "operator",
          "operatorId": "vision.preprocess.threshold",
          "displayName": "Threshold",
          "inputPorts": {
            "frame": "bbox2d",
            "image": "image"
          },
          "outputPorts": {
            "frame": "bbox2d",
            "mask": "image",
            "threshold": "number"
          },
          "paramSchema": {
            "properties": {
              "blockSize": {
                "default": 11,
                "description": "仅自适应模式生效，必须是大于等于 3 的奇数，如 3、5、11。",
                "title": "自适应邻域大小",
                "type": "integer",
                "xEnabledWhen": {
                  "mode": [
                    "adaptiveMean",
                    "adaptiveGaussian"
                  ]
                },
                "xExample": 11,
                "xMinimum": 3,
                "xOdd": true,
                "xUnit": "像素"
              },
              "constant": {
                "default": 2.0,
                "description": "仅自适应模式生效，从局部均值或加权均值中减去此有限数值，可为负数或小数。",
                "title": "自适应阈值偏移量",
                "type": "number",
                "xEnabledWhen": {
                  "mode": [
                    "adaptiveMean",
                    "adaptiveGaussian"
                  ]
                },
                "xExample": 2.0,
                "xUnit": "灰度级"
              },
              "invert": {
                "default": false,
                "description": "开启后反转二值掩码的前景与背景，输出仍为 0/255。",
                "title": "反向阈值",
                "type": "boolean"
              },
              "mode": {
                "default": "fixed",
                "description": "固定模式使用指定阈值；自动模式由图像计算阈值；自适应模式按局部邻域计算阈值。",
                "enum": [
                  "fixed",
                  "otsu",
                  "triangle",
                  "adaptiveMean",
                  "adaptiveGaussian"
                ],
                "title": "阈值模式",
                "type": "string",
                "xOptionLabels": {
                  "adaptiveGaussian": "自适应高斯",
                  "adaptiveMean": "自适应均值",
                  "fixed": "固定阈值",
                  "otsu": "大津法（自动阈值）",
                  "triangle": "三角法（自动阈值）"
                }
              },
              "threshold": {
                "default": 127,
                "description": "仅固定阈值模式生效，填写 0～255 的整数。",
                "title": "阈值",
                "type": "integer",
                "xEnabledWhen": {
                  "mode": [
                    "fixed"
                  ]
                },
                "xExample": 127,
                "xMaximum": 255,
                "xMinimum": 0,
                "xUnit": "灰度级"
              }
            },
            "type": "object"
          },
          "params": {
            "mode": "fixed",
            "threshold": 64
          },
          "targetWorkflowId": null,
          "loop": {}
        }
