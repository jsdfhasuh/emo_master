+        if event.type() in (QEvent.Resize, QEvent.LayoutRequest, QEvent.FontChange, QEvent.StyleChange, QEvent.Show):
+            if self.widget() is not None:
+                self.setMinimumHeight(self.minimumSizeHint().height())
