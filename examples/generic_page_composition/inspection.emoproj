                "type": "integer",
                "minimum": 1,
                "default": 640,
                "xUnit": "\u50cf\u7d20",
                "xExample": 640,
                "description": "\u6a21\u578b\u8f93\u5165\u7684\u76ee\u6807\u56fe\u50cf\u5c3a\u5bf8\uff0c\u586b\u5199\u6b63\u6574\u6570\u3002"
              },
              "maxDetections": {
                "title": "\u6700\u5927\u68c0\u6d4b\u6570\u91cf",
                "type": "integer",
                "minimum": 1,
                "default": 300,
                "xUnit": "\u4e2a",
                "xExample": 300,
                "description": "\u5355\u6b21\u63a8\u7406\u6700\u591a\u4fdd\u7559\u7684\u68c0\u6d4b\u7ed3\u679c\u6570\u91cf\u3002"
              },
              "device": {
                "title": "\u63a8\u7406\u8bbe\u5907",
                "type": "string",
                "enum": [
                  "auto",
                  "cpu"
                ],
                "default": "auto",
                "xOptionLabels": {
                  "auto": "\u81ea\u52a8\uff08\u5f53\u524d\u4f7f\u7528 CPU\uff09",
                  "cpu": "CPU"
                },
                "description": "\u5f53\u524d ONNX \u63a8\u7406\u4f7f\u7528 CPU \u6267\u884c\u63d0\u4f9b\u7a0b\u5e8f\u3002"
              },
              "classes": {
                "title": "\u68c0\u6d4b\u7c7b\u522b\uff08\u53ef\u9009\uff09",
                "description": "\u7559\u7a7a\u8868\u793a\u68c0\u6d4b\u6a21\u578b\u652f\u6301\u7684\u5168\u90e8\u7c7b\u522b\uff1b\u586b\u5199 0, 1 \u7b49\u7c7b\u522b\u7f16\u53f7\u65f6\u4ec5\u4fdd\u7559\u6307\u5b9a\u7c7b\u522b\uff0c\u4e5f\u53ef\u7c98\u8d34 [0, 1]\u3002\u7c7b\u522b\u540d\u79f0\u7531\u6a21\u578b\u51b3\u5b9a\u3002",
                "type": "array",
                "xWidget": "integer-list",
                "xPlaceholder": "\u5168\u90e8\u7c7b\u522b",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "default": [],
                "xBlankMeansEmpty": true,
                "xExample": [
                  0,
                  1
                ]
              },
              "agnosticNms": {
                "title": "\u4e0d\u533a\u5206\u7c7b\u522b\u7684\u975e\u6781\u5927\u503c\u6291\u5236",
                "type": "boolean",
                "default": false
