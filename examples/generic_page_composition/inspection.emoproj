                "title": "\u7ed8\u5236\u53e0\u52a0\u56fe",
                "type": "boolean",
                "default": true
              },
              "outputCrop": {
                "title": "\u8f93\u51fa\u88c1\u526a\u56fe",
                "type": "boolean",
                "default": false,
                "description": "\u8f93\u51fa\u6240\u9009\u68c0\u6d4b\u6846\u5185\u7684\u539f\u59cb\u50cf\u7d20\u548c\u88c1\u526a\u5750\u6807\u6846\uff1b\u4e0d\u662f\u5206\u5272\u63a9\u7801\uff0c\u4e5f\u4e0d\u88c1\u526a\u53e0\u52a0\u56fe\u3002"
              },
              "cropTargetIndex": {
                "title": "\u88c1\u526a\u76ee\u6807\u5e8f\u53f7\uff08\u4ece 1 \u5f00\u59cb\uff09",
                "type": "integer",
                "minimum": 1,
                "default": 1,
                "xEnabledWhen": {
                  "outputCrop": [
                    true
                  ]
                },
                "description": "\u6309\u7c7b\u522b\u8fc7\u6ee4\u3001\u7f6e\u4fe1\u5ea6\u7b5b\u9009\u548c NMS \u540e\u7684\u6709\u6548\u68c0\u6d4b\u6846\u6392\u5e8f\uff1a\u7f6e\u4fe1\u5ea6\u4ece\u9ad8\u5230\u4f4e\uff0c\u7b2c 1 \u4e2a\u6700\u9ad8\uff1b\u540c\u5206\u4fdd\u7559\u540e\u7aef\u987a\u5e8f\u3002\u5e8f\u53f7\u4ec5\u5c5e\u4e8e\u5f53\u524d\u56fe\u50cf\uff0c\u8d85\u51fa\u6570\u91cf\u65f6\u6309\u201c\u65e0\u88c1\u526a\u76ee\u6807\u65f6\u201d\u5904\u7406\u3002",
                "xVisibleWhen": {
                  "outputCrop": [
                    true
                  ]
                },
                "xValidateWhen": {
                  "outputCrop": [
                    true
                  ]
                }
              },
              "onMissingCrop": {
                "title": "\u65e0\u88c1\u526a\u76ee\u6807\u65f6",
                "type": "string",
                "enum": [
                  "error",
                  "skip"
