          "inputPorts": {
            "hasNext": "boolean"
          },
          "outputPorts": {},
          "paramSchema": {},
          "params": {},
          "targetWorkflowId": null,
          "loop": {}
        }
      ],
      "edges": [
        {
          "fromNode": "load",
          "fromPort": "image",
          "toNode": "blur",
          "toPort": "image"
        },
        {
          "fromNode": "load",
