                },
                "description": "\u56fa\u5b9a\u6a21\u5f0f\u4f7f\u7528\u6307\u5b9a\u9608\u503c\uff1b\u81ea\u52a8\u6a21\u5f0f\u7531\u56fe\u50cf\u8ba1\u7b97\u9608\u503c\uff1b\u81ea\u9002\u5e94\u6a21\u5f0f\u6309\u5c40\u90e8\u90bb\u57df\u8ba1\u7b97\u9608\u503c\u3002"
              },
              "threshold": {
                "title": "\u9608\u503c",
                "type": "integer",
                "default": 127,
                "xMinimum": 0,
                "xMaximum": 255,
                "xEnabledWhen": {
                  "mode": [
                    "fixed"
                  ]
                },
                "xUnit": "\u7070\u5ea6\u7ea7",
                "xExample": 127,
                "description": "\u4ec5\u56fa\u5b9a\u9608\u503c\u6a21\u5f0f\u751f\u6548\uff0c\u586b\u5199 0\uff5e255 \u7684\u6574\u6570\u3002"
              },
              "invert": {
                "title": "\u53cd\u5411\u9608\u503c",
                "type": "boolean",
                "default": false,
                "description": "\u5f00\u542f\u540e\u53cd\u8f6c\u4e8c\u503c\u63a9\u7801\u7684\u524d\u666f\u4e0e\u80cc\u666f\uff0c\u8f93\u51fa\u4ecd\u4e3a 0/255\u3002"
