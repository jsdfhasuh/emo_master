        {
          "nodeId": "load",
          "kind": "operator",
          "operatorId": "vision.io.video_loader",
          "displayName": "\u672c\u5730\u89c6\u9891\u53d6\u5e27",
          "inputPorts": {
            "videoPath": "string",
            "reset": "boolean"
          },
          "outputPorts": {
            "image": "image",
            "frame": "bbox2d",
            "videoPath": "string",
            "index": "integer",
            "frameIndex": "integer",
            "timestampSec": "number",
            "hasNext": "boolean"
          },
          "paramSchema": {
            "type": "object",
            "properties": {
              "videoPath": {
                "title": "\u89c6\u9891\u6587\u4ef6",
                "type": "string",
                "default": "",
                "xWidget": "file",
                "xFileMode": "open",
                "xFilter": "\u89c6\u9891\u6587\u4ef6 (*.mp4 *.avi *.mkv *.mov *.wmv *.m4v *.webm *.mpg *.mpeg);;\u6240\u6709\u6587\u4ef6 (*)"
              },
              "intervalSec": {
                "title": "\u53d6\u5e27\u95f4\u9694\uff08\u79d2\uff09",
                "type": "number",
                "exclusiveMinimum": 0.0,
                "default": 1.0
              },
              "colorMode": {
                "title": "\u989c\u8272\u6a21\u5f0f",
                "type": "string",
                "enum": [
                  "color",
                  "grayscale"
                ],
                "default": "color"
              }
            },
            "required": [
              "videoPath"
            ]
          },
          "params": {
            "videoPath": "",
            "intervalSec": 0.25
          },
          "targetWorkflowId": null,
          "loop": {}
        },
        {
          "nodeId": "blur",
          "kind": "operator",
          "operatorId": "vision.preprocess.blur",
          "displayName": "Blur / Denoise",
          "inputPorts": {
            "image": "image",
            "frame": "bbox2d"
          },
          "outputPorts": {
            "image": "image",
            "frame": "bbox2d"
          },
          "paramSchema": {
            "type": "object",
            "properties": {
              "mode": {
                "title": "\u6ee4\u6ce2\u6a21\u5f0f",
                "type": "string",
                "enum": [
                  "gaussian",
                  "median",
                  "bilateral",
                  "mean"
                ],
                "default": "gaussian",
                "xOptionLabels": {
                  "gaussian": "\u9ad8\u65af\u6ee4\u6ce2",
                  "median": "\u4e2d\u503c\u6ee4\u6ce2",
                  "bilateral": "\u53cc\u8fb9\u6ee4\u6ce2",
                  "mean": "\u5747\u503c\u6ee4\u6ce2"
                },
                "description": "\u9ad8\u65af\u9002\u5408\u4e00\u822c\u5e73\u6ed1\uff0c\u4e2d\u503c\u9002\u5408\u6912\u76d0\u566a\u58f0\uff0c\u53cc\u8fb9\u6ee4\u6ce2\u53ef\u4fdd\u7559\u8fb9\u7f18\uff0c\u5747\u503c\u6ee4\u6ce2\u5bf9\u90bb\u57df\u7b49\u6743\u5e73\u5747\u3002"
              },
              "kernelSize": {
                "title": "\u5377\u79ef\u6838\u5927\u5c0f",
                "type": "integer",
                "minimum": 3,
                "default": 5,
                "xUnit": "\u50cf\u7d20",
                "xOdd": true,
                "xExample": 5,
                "description": "\u5377\u79ef\u6838\u8fb9\u957f\uff0c\u5fc5\u987b\u662f\u5927\u4e8e\u7b49\u4e8e 3 \u7684\u5947\u6570\u3002",
                "xVisibleWhen": {
                  "mode": [
                    "gaussian",
                    "median",
                    "mean"
                  ]
                },
                "xValidateWhen": {
                  "mode": [
                    "gaussian",
                    "median",
                    "mean"
                  ]
                }
              },
              "sigmaX": {
                "title": "\u6c34\u5e73\u65b9\u5411\u6807\u51c6\u5dee",
                "type": "number",
                "minimum": 0,
                "default": 0,
                "xUnit": "\u50cf\u7d20",
                "xExample": 0,
                "description": "\u9ad8\u65af\u6c34\u5e73\u65b9\u5411\u6807\u51c6\u5dee\uff0c0 \u8868\u793a\u7531\u5377\u79ef\u6838\u5927\u5c0f\u81ea\u52a8\u8ba1\u7b97\u3002",
                "xVisibleWhen": {
                  "mode": [
                    "gaussian"
                  ]
                },
                "xValidateWhen": {
                  "mode": [
                    "gaussian"
                  ]
                }
              },
              "sigmaY": {
                "title": "\u5782\u76f4\u65b9\u5411\u6807\u51c6\u5dee",
                "type": "number",
                "minimum": 0,
                "default": 0,
                "xUnit": "\u50cf\u7d20",
                "xExample": 0,
                "description": "\u9ad8\u65af\u5782\u76f4\u65b9\u5411\u6807\u51c6\u5dee\uff0c0 \u8868\u793a\u4e0e\u6c34\u5e73\u65b9\u5411\u76f8\u540c\u3002",
                "xVisibleWhen": {
                  "mode": [
                    "gaussian"
                  ]
                },
                "xValidateWhen": {
                  "mode": [
                    "gaussian"
                  ]
                }
              },
              "diameter": {
                "title": "\u6ee4\u6ce2\u90bb\u57df\u76f4\u5f84\uff08\u50cf\u7d20\uff09",
                "type": "integer",
                "minimum": 1,
                "default": 9,
                "xUnit": "\u50cf\u7d20",
                "xExample": 9,
                "description": "\u53cc\u8fb9\u6ee4\u6ce2\u90bb\u57df\u76f4\u5f84\uff0c\u586b\u5199\u5927\u4e8e\u7b49\u4e8e 1 \u7684\u6574\u6570\u3002",
                "xVisibleWhen": {
                  "mode": [
                    "bilateral"
                  ]
                },
                "xValidateWhen": {
                  "mode": [
                    "bilateral"
                  ]
                }
              },
              "sigmaColor": {
                "title": "\u989c\u8272\u7a7a\u95f4\u6807\u51c6\u5dee",
                "type": "number",
                "exclusiveMinimum": 0,
                "default": 75,
                "xUnit": "\u989c\u8272\u503c",
                "xExample": 75,
                "description": "\u53cc\u8fb9\u6ee4\u6ce2\u7684\u989c\u8272\u5dee\u5f02\u6807\u51c6\u5dee\uff0c\u5fc5\u987b\u4e3a\u6b63\u6570\u3002",
                "xVisibleWhen": {
                  "mode": [
                    "bilateral"
                  ]
                },
                "xValidateWhen": {
                  "mode": [
                    "bilateral"
                  ]
                }
              },
              "sigmaSpace": {
                "title": "\u5750\u6807\u7a7a\u95f4\u6807\u51c6\u5dee",
                "type": "number",
                "exclusiveMinimum": 0,
                "default": 75,
                "xUnit": "\u50cf\u7d20",
                "xExample": 75,
                "description": "\u53cc\u8fb9\u6ee4\u6ce2\u7684\u7a7a\u95f4\u8ddd\u79bb\u6807\u51c6\u5dee\uff0c\u5fc5\u987b\u4e3a\u6b63\u6570\u3002",
                "xVisibleWhen": {
                  "mode": [
                    "bilateral"
                  ]
                },
                "xValidateWhen": {
                  "mode": [
                    "bilateral"
                  ]
                }
              }
            },
            "xModeOperator": "vision.preprocess.blur"
          },
          "params": {
            "mode": "gaussian",
            "kernelSize": 3
          },
          "targetWorkflowId": null,
          "loop": {}
