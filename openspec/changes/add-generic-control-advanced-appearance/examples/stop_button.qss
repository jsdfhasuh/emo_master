/* 页头停止按钮的四态。 */
QPushButton[emoPart="action"] {
    background: #FFF7E8;
    color: #9B580A;
    border: 1px solid #D8B57B;
}
QPushButton[emoPart="action"]:enabled:hover {
    background: #FFF2E1;
    border-color: #C88A2F;
}
QPushButton[emoPart="action"]:enabled:pressed {
    background: #F8E0B5;
    border-color: #995305;
}
QPushButton[emoPart="action"]:disabled {
    background: #E8EDF3;
    color: #8190A3;
    border-color: #D2DCE6;
}
