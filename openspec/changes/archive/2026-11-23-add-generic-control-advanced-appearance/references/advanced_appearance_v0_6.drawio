try"/></mxCell><mxCell id="04-plan-v05-1018" value="每类都有常用字段与原生代码样例；" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=18;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#61738B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1144" y="239" width="570" height="34" as="geometry"/></mxCell><mxCell id="04-plan-v05-1019" value="页面级原生级联列后续候选。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=18;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#61738B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1144" y="273" width="570" height="34" as="geometry"/></mxCell><mxCell id="04-plan-v05-1020" value="" style="shape=rectangle;html=0;fillColor=#F8FAFD;strokeColor=#CCD6E4;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="52" y="339" width="1696" height="115" as="geometry"/></mxCell><mxCell id="04-plan-v05-1021" value="02 模型与保存" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=23;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#142A43;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="75" y="362" width="280" height="40" as="geometry"/></mxCell><mxCell id="04-plan-v05-1022" value="扩展通用外观和 customStyle；生成契约。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=18;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#142A43;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="365" y="358" width="750" height="34" as="geometry"/></mxCell><mxCell id="04-plan-v05-1023" value="启用开关、代码、另一端样式一起保留。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=18;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#142A43;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="365" y="392" width="750" height="34" as="geometry"/></mxCell><mxCell id="04-plan-v05-1024" value="保存重开、发布转换不丢字段；" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=18;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#61738B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1144" y="358" width="570" height="34" as="geometry"/></mxCell><mxCell id="04-plan-v05-1025" value="没有自定义代码时使用原默认外观。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=18;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#61738B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1144" y="392" width="570" height="34" as="geometry"/></mxCell><mxCell id="04-plan-v05-1026" value="" style="shape=rectangle;html=0;fillColor=#FFFFFF;strokeColor=#CCD6E4;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="52" y="458" width="1696" height="115" as="geometry"/></mxCell><mxCell id="04-plan-v05-1027" value="03 Designer / Qt" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=23;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#142A43;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="75" y="481" width="280" height="40" as="geometry"/></mxCell><mxCell id="04-plan-v05-1028" value="原弹窗加入 QSS、选择器与局部预览。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=18;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#142A43;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="365" y="477" width="750" height="34" as="geometry"/></mxCell><mxCell id="04-plan-v05-1029" value="合并叶子控件样式，接入刷新与页头按钮。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=18;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#142A43;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="365" y="511" width="750" height="34" as="geometry"/></mxCell><mxCell id="04-plan-v05-1030" value="确定可撤销，取消不提交草稿；" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=18;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#61738B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1144" y="477" width="570" height="34" as="geometry"/></mxCell><mxCell id="04-plan-v05-1031" value="Qt Runtime 与预览使用同一应用逻辑。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=18;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#61738B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1144" y="511" width="570" height="34" as="geometry"/></mxCell><mxCell id="04-plan-v05-1032" value="" style="shape=rectangle;html=0;fillColor=#F8FAFD;strokeColor=#CCD6E4;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="52" y="577" width="1696" height="115" as="geometry"/></mxCell><mxCell id="04-plan-v05-1033" value="04 Web / CSS" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=23;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#142A43;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="75" y="600" width="280" height="40" as="geometry"/></mxCell><mxCell id="04-plan-v05-1034" value="原外观组加入 CSS 编辑与局部预览。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=18;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#142A43;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="365" y="596" width="7