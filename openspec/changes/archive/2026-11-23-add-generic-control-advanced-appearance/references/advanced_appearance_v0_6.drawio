ry-v05-1029" value="选中现有组件" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=21;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#D97C20;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1495" y="214" width="248" height="36" as="geometry"/></mxCell><mxCell id="09-web-entry-v05-1030" value="示例选原画布里的导航按钮" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=18;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#61738B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1451" y="259" width="292" height="29" as="geometry"/></mxCell><mxCell id="09-web-entry-v05-1031" value="“去详情”。其他组件按" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=18;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#61738B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1451" y="288" width="292" height="29" as="geometry"/></mxCell><mxCell id="09-web-entry-v05-1032" value="相同方式进入自己的外观。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=18;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#61738B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1451" y="317" width="292" height="29" as="geometry"/></mxCell><mxCell id="09-web-entry-v05-1033" value="" style="shape=ellipse;html=0;fillColor=#D97C20;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1451" y="458" width="34" height="34" as="geometry"/></mxCell><mxCell id="09-web-entry-v05-1034" value="2" style="text;html=0;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=20;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#FFFFFF;fontStyle=1;spaci