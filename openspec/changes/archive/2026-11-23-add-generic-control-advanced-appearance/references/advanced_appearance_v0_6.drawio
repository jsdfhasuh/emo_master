owrap;overflow=visible;fontSize=20;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#FFFFFF;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1452" y="712" width="32" height="32" as="geometry"/></mxCell><mxCell id="09-web-entry-v05-1041" value="在 Web 写 CSS" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=21;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#D97C20;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1495" y="710" width="248" height="36" as="geometry"/></mxCell><mxCell id="09-web-entry-v05-1042" value="常用配置下面提供 CSS。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=18;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#61738B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1451" y="755" width="292" height="29" as="geometry"/></mxCell><mxCell id="09-web-entry-v05-1043" value="仅影响当前组件及其部位；" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=18;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#61738B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1451" y="784" width="292" height="29" as="geometry"/></mxCell><mxCell id="09-web-entry-v05-1044" value="保存与发布沿用原流程。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=18;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#61738B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1451" y="813" width="292" height="29" as="geometry"/></mxCell><mxCell id="09-web-entry-v05-1045" value="底图来自 2026-11-04 历史浏览器验收（React / Edge，HTTP / WS 模拟，画面含 Synthetic review）。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=17;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#61738B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="52" y="1143" width="1696" height="30" as="geometry"/></mxCell><mxCell id="09-web-entry-v05-1046" value="选中状态和右属性内容为拟新增覆盖层；它们不是本次实际运行截图，也不代表最新版本全貌。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=17;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#61738B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="52" y="1173" width="1696" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="10-web-css" name="10 Web 自定义 CSS 与预览"><mxGraphModel dx="1800" dy="1370" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1370" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="10-web-css-v05-1001" value="" style="shape=rectangle;html=0;fillColor=#F5F7FB;strokeColor=none;strokeWidth=1;locked=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="1370" as="geometry"/></mxCell><mxCell id="10-web-css-v05-1002" value="" style="shape=rectangle;html=0;fillColor=#D97C20;strokeColor=none;strokeWidth=1;rounded=1;absoluteArcSize=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="52" y="44" width="8" height="57" as="geometry"/></mxCell><mxCell id="10-web-css-v05-1003" value="Web 高级外观：直接编辑 CSS，并在旁边预览" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=34;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#142A43;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="82" y="31" width="1380" height="56" as="geometry"/></mxCell><mxCell id="10-web-css-v05-1004" value="使用 Web 原有深色编辑器风格；本页的弹窗与样式效果均为拟议新增。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap