ometry"/></mxCell><mxCell id="08-designer-advanced-v05-1064" value="并保留代码。选择器由界面" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=18;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#61738B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1451" y="483" width="292" height="29" as="geometry"/></mxCell><mxCell id="08-designer-advanced-v05-1065" value="提供，不需要猜控件层级。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=18;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#61738B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1451" y="512" width="292" height="29" as="geometry"/></mxCell><mxCell id="08-designer-advanced-v05-1066" value="" style="shape=ellipse;html=0;fillColor=#D97C20;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1451" y="645" width="34" height="34" as="geometry"/></mxCell><mxCell id="08-designer-advanced-v05-1067" value="3" style="text;html=0;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=20;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#FFFFFF;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1452" y="646" width="32" height="32" as="geometry"/></mxCell><mxCell id="08-designer-advanced-v05-1068" value="改完立即看效果" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=21;fontFamily=Noto Sans CJK SC, Microsoft YaHei, sans-serif;fontColor=#D97C20;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1495" y="644" width="248" height="36" as="geometry"/></mxCell><mxCell id="08-designer-advanced-v05-1069" value="左边框加粗到 4 px；" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=18;fon