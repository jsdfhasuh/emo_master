QMainWindow, QDialog { background: #f5f6f8; }
QWidget { color: #20242b; }
QLabel { background: transparent; border: none; }
QLabel#panelTitle { font-weight: 600; padding: 8px 0; }
QLabel#mutedText, QLabel#recentProjectPath { color: #626b78; }
QLabel#statusCard { padding: 4px 0; }
QWidget#rightPanelSection { background: #ffffff; border: none; }
QWidget#sidebarCategorySection, QWidget#sidebarDependencySection,
QWidget#sidebarNodeSection { background: transparent; border: none; }
QWidget#operatorBubble { background: #ffffff; border: 1px solid #d8dce3; border-radius: 8px; }
QMenuBar { background: #ffffff; border-bottom: 1px solid #d8dce3; }
QMenuBar::item { padding: 5px 12px; background: transparent; }
QMenuBar::item:selected { background: #edf3ff; }
QMenu { background: #ffffff; border: 1px solid #d8dce3; padding: 4px; }
QMenu::item { padding: 7px 26px; border-radius: 4px; }
QMenu::item:selected { background: #edf3ff; color: #1748b5; }
QMenu::item:disabled { color: #9299a4; }
QMenu::separator { height: 1px; background: #e5e7eb; margin: 4px 6px; }
QToolBar { background: #ffffff; border: none; border-bottom: 1px solid #d8dce3; spacing: 4px; padding: 6px 8px; }
QToolBar::separator { width: 1px; background: #e5e7eb; margin: 5px 6px; }
QToolButton { background: transparent; border: 1px solid transparent; border-radius: 4px; padding: 5px 7px; }
QToolButton:hover { background: #edf3ff; border-color: #d7e4ff; }
QToolButton:pressed, QToolButton:checked { background: #dce8ff; color: #1748b5; }
QToolButton:disabled { color: #9299a4; }
QToolButton#primaryButton, QPushButton#primaryButton,
QPushButton#startupPrimaryAction, QPushButton#workflowPackageImportButton {
  background: #2563eb; border: 1px solid #2563eb; color: #ffffff;
}
QToolButton#primaryButton:hover, QPushButton#primaryButton:hover,
QPushButton#startupPrimaryAction:hover { background: #1d4ed8; }
QToolButton#dangerButton:enabled { background: #fef2f2; border-color: #fecaca; color: #b91c1c; }
QPushButton { background: #ffffff; border: 1px solid #d8dce3; border-radius: 4px; padding: 6px 14px; }
QPushButton:hover { background: #f0f4fa; border-color: #b7c5dc; }
QPushButton:pressed { background: #e4ebf7; }
QPushButton:focus, QToolButton:focus { border-color: #2563eb; }
QPushButton:disabled, QPushButton#primaryButton:disabled,
QToolButton#primaryButton:disabled, QToolButton#dangerButton:disabled {
  background: #f1f2f4; border-color: #e1e4e9; color: #9299a4;
}
QPushButton#sideCategoryButton, QPushButton#sideCategoryButtonActive { text-align: left; padding: 7px 6px; }
QPushButton#sideCategoryButtonActive { background: #edf3ff; border-color: #c5d7fc; color: #1748b5; }
QPushButton#sidebarToggleButton { background: transparent; padding: 0; border-color: transparent; }
QPushButton#sidebarToggleButton:hover { background: #e7edf7; }
QTabWidget#workflowTabs::pane { border: none; background: transparent; }
QTabWidget#workflowTabs QTabBar::tab {
  background: transparent; border: none; border-bottom: 2px solid transparent;
  padding: 7px 12px; margin-right: 2px; color: #626b78; font-weight: 400;
}
QTabWidget#workflowTabs QTabBar::tab:selected { background: #ffffff; border-bottom-color: #2563eb; color: #20242b; font-weight: 600; }
QTabWidget#workflowTabs QTabBar::tab:hover { background: #edf3ff; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit, QPlainTextEdit {
  background: #ffffff; border: 1px solid #d8dce3; border-radius: 4px;
  padding: 5px 7px; selection-background-color: #2563eb; selection-color: #ffffff;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus,
QTextEdit:focus, QPlainTextEdit:focus { border-color: #2563eb; }
QComboBox { padding-right: 24px; }
QComboBox::drop-down { width: 22px; border: none; }
QComboBox::down-arrow { image: url(:/designer/chevron-down.svg); width: 14px; height: 14px; }
QSpinBox, QDoubleSpinBox { padding-right: 20px; }
QSpinBox::up-button, QDoubleSpinBox::up-button {
  subcontrol-origin: border; subcontrol-position: top right;
  width: 20px; border-left: 1px solid #d8dce3; border-top-right-radius: 4px;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
  subcontrol-origin: border; subcontrol-position: bottom right;
  width: 20px; border-left: 1px solid #d8dce3; border-bottom-right-radius: 4px;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(:/designer/chevron-up.svg); width: 12px; height: 12px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(:/designer/chevron-down.svg); width: 12px; height: 12px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #bbc3cf; border-radius: 3px; background: #ffffff; }
QCheckBox::indicator:checked { image: url(:/designer/check.svg); background: #edf3ff; border-color: #2563eb; }
QListWidget, QTreeWidget, QTableWidget {
  background: #ffffff; alternate-background-color: #f8f9fb; border: 1px solid #e1e4e9;
  border-radius: 4px; selection-background-color: #e5eeff; selection-color: #20242b;
}
QListWidget::item, QTreeWidget::item { padding: 5px 6px; border: none; }
QListWidget::item:selected, QTreeWidget::item:selected { background: #e5eeff; color: #1748b5; }
QListWidget::item:hover, QTreeWidget::item:hover { background: #f0f4fa; }
QHeaderView::section { background: #f5f6f8; color: #626b78; border: none; border-bottom: 1px solid #d8dce3; padding: 7px 8px; }
QTableWidget { gridline-color: #edf0f4; }
QGraphicsView { background: #f5f6f8; border: 1px solid #e1e4e9; border-radius: 0; padding: 0; }
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { width: 10px; background: transparent; margin: 0; }
QScrollBar:horizontal { height: 10px; background: transparent; margin: 0; }
QScrollBar::handle { background: #c3c9d2; border-radius: 4px; min-height: 28px; min-width: 28px; }
QScrollBar::handle:hover { background: #929baa; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QSplitter::handle { background: #e8ebf0; }
QSplitter::handle:hover { background: #c5d7fc; }
PreviewLabel, QLabel#previewCard, QLabel#previewImage { background: #f0f2f5; border: 1px solid #e1e4e9; border-radius: 4px; color: #626b78; }
QDockWidget#runtimeLogDock { background: #ffffff; }
QDockWidget#runtimeLogDock::title { background: #f5f6f8; padding: 7px 10px; border-bottom: 1px solid #d8dce3; }
QTextEdit#runtimeLogDetails { background: #fafbfc; color: #374151; }
QLabel#startupHeroTitle { font-size: 16pt; font-weight: 600; }
QLabel#startupHeroSubtitle { color: #626b78; }
QWidget#startupHeroSection, QWidget#startupActionSection, QWidget#startupRecentSection { background: transparent; border: none; }
QListWidget#recentProjectsList::item { padding: 10px 12px; border-bottom: 1px solid #edf0f4; }
QPushButton#operatorBubbleItem, QPushButton#operatorBubbleItemPre,
QPushButton#operatorBubbleItemDetect, QPushButton#operatorBubbleItemMeasure,
QPushButton#operatorBubbleItemOutput, QPushButton#operatorBubbleItemFlow {
  background: #ffffff; border: 1px solid #e1e4e9; border-radius: 6px; text-align: left; padding: 8px;
}
QPushButton#operatorBubbleItem:hover, QPushButton#operatorBubbleItemPre:hover,
QPushButton#operatorBubbleItemDetect:hover, QPushButton#operatorBubbleItemMeasure:hover,
QPushButton#operatorBubbleItemOutput:hover, QPushButton#operatorBubbleItemFlow:hover { background: #edf3ff; border-color: #b9cef9; }
QLabel#workflowPackageSummary { font-weight: 600; padding: 4px 0; }
QLabel#workflowPackageWarnings { background: #fffbeb; color: #92400e; border: 1px solid #fde68a; border-radius: 4px; padding: 8px; }
QToolTip { background: #ffffff; color: #20242b; border: 1px solid #c5cbd5; padding: 6px; }
