{
  "operatorId": "vision.edge.canny",
  "displayName": "Canny Edge",
  "version": "1.1.0",
  "entry": "emo_master.plugins.builtins.canny_edge.operator:CannyEdgeOperator",
  "category": "检测",
  "iconKey": "edge",
  "summary": "提取图像边缘并输出边缘图与叠加图。",
  "inputPorts": {
    "image": {"type": "image", "required": true, "nullable": false},
    "frame": {
      "type": "bbox2d",
      "required": false,
      "nullable": false,
      "schemaVersion": "1.x"
    }
  },
  "outputPorts": {
    "edges": {"type": "image", "required": true, "nullable": false},
    "overlay": {"type": "image", "required": true, "nullable": false},
    "frame": {
      "type": "bbox2d",
      "required": true,
      "nullable": false,
      "schemaVersion": "1.x"
    }
  },
  "paramSchema": {
    "type": "object",
    "properties": {
      "thresholdLow": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "default": 50
      },
      "thresholdHigh": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "default": 150
      },
      "apertureSize": {
        "type": "integer",
        "enum": [3, 5, 7],
        "default": 3
      },
      "l2Gradient": {
        "type": "boolean",
        "default": false
      }
    },
    "required": ["thresholdLow", "thresholdHigh"]
  },
  "minCoreVersion": "0.1.0",
  "maxCoreVersion": "1.x"
}
