{
  "operatorId": "vision.preprocess.clahe",
  "displayName": "CLAHE",
  "version": "1.0.0",
  "entry": "emo_master.plugins.builtins._intensity_operators:ClaheOperator",
  "category": "预处理",
  "iconKey": "clahe",
  "summary": "对灰度图或 BGR 图像 LAB 色彩空间的 L 通道执行 CLAHE。",
  "inputPorts": {
    "image": {"type": "image", "required": true, "nullable": false},
    "frame": {"type": "bbox2d", "required": false, "nullable": false, "schemaVersion": "1.x"}
  },
  "outputPorts": {
    "image": {"type": "image", "required": true, "nullable": false},
    "frame": {"type": "bbox2d", "required": true, "nullable": false, "schemaVersion": "1.x"}
  },
  "paramSchema": {
    "type": "object",
    "properties": {
      "clipLimit": {
        "title": "对比度限制",
        "type": "number",
        "exclusiveMinimum": 0.0,
        "default": 2.0,
        "xExample": 2.0,
        "description": "正数对比度限制；数值越大，允许的局部对比度增强越强。"
      },
      "tileGridWidth": {
        "title": "分块列数",
        "type": "integer",
        "minimum": 1,
        "maximum": 64,
        "default": 8,
        "xUnit": "列",
        "xExample": 8,
        "description": "图像水平方向的分块数量，范围为 1～64。"
      },
      "tileGridHeight": {
        "title": "分块行数",
        "type": "integer",
        "minimum": 1,
        "maximum": 64,
        "default": 8,
        "xUnit": "行",
        "xExample": 8,
        "description": "图像垂直方向的分块数量，范围为 1～64。"
      }
    }
  },
  "minCoreVersion": "0.3.0",
  "maxCoreVersion": "1.x",
  "resultSchema": {
    "inputs": {
      "image": {"title": "图像", "description": "uint8 灰度/BGR图像；彩色只增强LAB的L通道再转回BGR。"},
      "frame": {"title": "坐标框", "description": "可选有效矩形和回源坐标；缺失全图默认。"}
    },
    "outputs": {
      "image": {"title": "图像", "description": "CLAHE后的同尺寸图像。"},
      "frame": {"title": "坐标框", "description": "原规范化输入frame透传。"}
    },
    "metrics": {
      "latencyMs": {
        "title": "算子内部耗时",
        "description": "从 _enhance 开始到返回的耗时；CLAHE对象创建与参数验证不在此计时内。",
        "unit": "ms",
        "group": "duration"
      }
    },
    "diagnostics": {
      "text": {"title": "摘要", "description": "CLAHE完成摘要。"}
    }
  }
}
