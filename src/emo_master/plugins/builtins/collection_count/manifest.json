          "detections": "检测结果",
          "blobs": "连通域",
          "contours": "轮廓",
          "measurements": "形状测量",
          "lines": "直线",
          "circles": "圆",
          "matches": "模板匹配结果"
        }
      }
    },
    "xModeOperator": "vision.collection.count"
