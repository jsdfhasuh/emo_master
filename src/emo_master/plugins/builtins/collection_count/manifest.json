{
  "operatorId": "vision.collection.count",
  "displayName": "Count Collection",
  "version": "1.1.0",
  "entry": "emo_master.plugins.builtins.collection_count.operator:CollectionCountOperator",
  "category": "结果处理",
  "iconKey": "count",
  "summary": "统计 Blob 或 Detection 集合中的目标数量。",
  "inputPorts": {
