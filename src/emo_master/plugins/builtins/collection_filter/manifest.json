{
  "operatorId": "vision.collection.filter",
  "displayName": "Filter Collection",
  "version": "1.1.0",
  "entry": "emo_master.plugins.builtins.collection_filter.operator:CollectionFilterOperator",
  "category": "结果处理",
  "iconKey": "filter",
  "summary": "按类型字段及空间关系过滤强类型视觉集合。",
  "inputPorts": {
    "blobs": {"type": "blobCollection", "required": false, "nullable": false, "schemaVersion": "1.x"},
    "detections": {"type": "detectionCollection", "required": false, "nullable": false, "schemaVersion": "1.x"},
    "contours": {"type": "contourCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "measurements": {"type": "shapeMeasurementCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "lines": {"type": "lineCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "circles": {"type": "circleCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "matches": {"type": "templateMatchCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "roi": {"type": "geometry2d", "required": false, "nullable": false, "schemaVersion": "1.x"}
  },
  "outputPorts": {
    "keptCount": {"type": "integer", "required": true, "nullable": false},
    "rejectedCount": {"type": "integer", "required": true, "nullable": false},
    "keptBlobs": {"type": "blobCollection", "required": false, "nullable": false, "schemaVersion": "1.x"},
    "rejectedBlobs": {"type": "blobCollection", "required": false, "nullable": false, "schemaVersion": "1.x"},
    "keptDetections": {"type": "detectionCollection", "required": false, "nullable": false, "schemaVersion": "1.x"},
    "rejectedDetections": {"type": "detectionCollection", "required": false, "nullable": false, "schemaVersion": "1.x"},
    "keptContours": {"type": "contourCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "rejectedContours": {"type": "contourCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "keptMeasurements": {"type": "shapeMeasurementCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "rejectedMeasurements": {"type": "shapeMeasurementCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "keptLines": {"type": "lineCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "rejectedLines": {"type": "lineCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "keptCircles": {"type": "circleCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "rejectedCircles": {"type": "circleCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "keptMatches": {"type": "templateMatchCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "rejectedMatches": {"type": "templateMatchCollection", "required": false, "nullable": false, "schemaVersion": "1.2"}
  },
  "paramSchema": {
    "type": "object",
    "properties": {
      "minArea": {"title": "最小面积", "type": "number", "minimum": 0.0, "default": 0.0},
      "maxArea": {"title": "最大面积", "type": "number", "minimum": 0.0, "default": 0.0},
      "minPerimeter": {"title": "最小周长", "type": "number", "minimum": 0.0, "default": 0.0},
      "maxPerimeter": {"title": "最大周长", "type": "number", "minimum": 0.0, "default": 0.0},
      "circularityEnabled": {"title": "启用圆度筛选", "type": "boolean", "default": false},
      "minCircularity": {"title": "最小圆度", "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.0},
      "maxCircularity": {"title": "最大圆度", "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 1.0},
      "blobLabels": {"title": "连通域标签", "type": "array", "items": {"type": "integer", "minimum": 0}, "default": []},
      "contourMode": {"title": "轮廓筛选模式", "type": "string", "enum": ["any", "present", "absent"], "default": "any"},
      "minConfidence": {"title": "最低置信度", "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.0},
      "maxConfidence": {"title": "最高置信度", "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 1.0},
      "classIds": {"title": "类别编号", "type": "array", "items": {"type": "integer", "minimum": 0}, "default": []},
      "detectionLabels": {"title": "检测标签", "type": "array", "items": {"type": "string"}, "default": []},
      "geometryTypes": {"title": "几何类型", "type": "array", "items": {"type": "string", "enum": ["bbox2d", "polygon2d", "rotatedBox2d"]}, "default": []},
      "holeMode": {"title": "孔洞筛选模式", "type": "string", "enum": ["any", "outer", "hole"], "default": "any"},
      "sourceTypes": {"title": "来源类型", "type": "array", "items": {"type": "string", "enum": ["contour", "blob"]}, "default": []},
      "minLength": {"title": "最小长度", "type": "number", "minimum": 0.0, "default": 0.0},
      "maxLength": {"title": "最大长度", "type": "number", "minimum": 0.0, "default": 0.0},
      "minRadius": {"title": "最小半径（像素）", "type": "number", "minimum": 0.0, "default": 0.0},
      "maxRadius": {"title": "最大半径（像素）", "type": "number", "minimum": 0.0, "default": 0.0},
      "minQuality": {"title": "最低质量", "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.0},
      "maxQuality": {"title": "最高质量", "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 1.0},
      "templateMethods": {"title": "模板匹配方法", "type": "array", "items": {"type": "string", "enum": ["sqdiff", "sqdiffNormed", "ccorr", "ccorrNormed", "ccoeff", "ccoeffNormed"]}, "default": []},
      "spatialMode": {"title": "空间筛选模式", "type": "string", "enum": ["bboxContained", "bboxIntersects", "centerInside", "none"], "default": "none"}
    }
  },
  "minCoreVersion": "0.3.0",
  "maxCoreVersion": "1.x"
}
