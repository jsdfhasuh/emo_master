      "radiusEnabled": {"title":"半径筛选","type":"boolean","xVisibleWhen":{"collectionType":["circles"]},"xValidateWhen":{"collectionType":["","circles"]}},
      "minRadius": {"title":"最小半径（像素）","type":"number","minimum":0,"default":0,"xVisibleWhen":{"collectionType":["circles"],"radiusEnabled":[true]},"xValidateWhen":{"collectionType":["","circles"],"radiusEnabled":[true]}},
      "maxRadius": {"title":"最大半径（像素）","type":"number","minimum":0,"default":0,"xVisibleWhen":{"collectionType":["circles"],"radiusEnabled":[true]},"xValidateWhen":{"collectionType":["","circles"],"radiusEnabled":[true]}},
      "qualityEnabled": {"title":"质量筛选","type":"boolean","xVisibleWhen":{"collectionType":["matches"]},"xValidateWhen":{"collectionType":["","matches"]}},
      "minQuality": {"title":"最低质量","type":"number","minimum":0,"maximum":1,"default":0,"xVisibleWhen":{"collectionType":["matches"],"qualityEnabled":[true]},"xValidateWhen":{"collectionType":["","matches"],"qualityEnabled":[true]}},
      "maxQuality": {"title":"最高质量","type":"number","minimum":0,"maximum":1,"default":1,"xVisibleWhen":{"collectionType":["matches"],"qualityEnabled":[true]},"xValidateWhen":{"collectionType":["","matches"],"qualityEnabled":[true]}},
      "templateMethodsEnabled": {"title":"模板匹配方法筛选","type":"boolean","xVisibleWhen":{"collectionType":["matches"]},"xValidateWhen":{"collectionType":["","matches"]}},
      "templateMethods": {"title":"模板匹配方法","type":"array","items":{"type":"string","enum":["sqdiff","sqdiffNormed","ccorr","ccorrNormed","ccoeff","ccoeffNormed"],"xOptionLabels":{"sqdiff":"平方差","sqdiffNormed":"归一化平方差","ccorr":"互相关","ccorrNormed":"归一化互相关","ccoeff":"相关系数","ccoeffNormed":"归一化相关系数"}},"default":[],"xVisibleWhen":{"collectionType":["matches"],"templateMethodsEnabled":[true]},"xValidateWhen":{"collectionType":["","matches"],"templateMethodsEnabled":[true]},"xOptionLabels":{"sqdiff":"平方差","sqdiffNormed":"归一化平方差","ccorr":"互相关","ccorrNormed":"归一化互相关","ccoeff":"相关系数","ccoeffNormed":"归一化相关系数"}},
      "spatialEnabled": {"title":"空间关系筛选","type":"boolean","xVisibleWhen":{"collectionType":["detections","blobs","contours","measurements","lines","circles","matches"]},"xValidateWhen":{"collectionType":["","detections","blobs","contours","measurements","lines","circles","matches"]}},
      "spatialMode": {"title":"空间筛选模式","type":"string","enum":["bboxContained","bboxIntersects","centerInside","none"],"default":"none","xVisibleWhen":{"collectionType":["detections","blobs","contours","measurements","lines","circles","matches"],"spatialEnabled":[true]},"xValidateWhen":{"collectionType":["","detections","blobs","contours","measurements","lines","circles","matches"],"spatialEnabled":[true]},"xOptionLabels":{"none":"请选择空间关系","centerInside":"中心位于区域内","bboxIntersects":"包围框与区域相交","bboxContained":"包围框完全位于区域内"}}
    }
  },
  "minCoreVersion": "0.3.0",
  "maxCoreVersion": "1.x"
