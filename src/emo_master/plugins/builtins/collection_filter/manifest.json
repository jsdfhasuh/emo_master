      "maxCircularity": {"title":"最大圆度","type":"number","minimum":0,"maximum":1,"default":1,"xVisibleWhen":{"collectionType":["blobs","measurements"],"circularityEnabled":[true]},"xValidateWhen":{"collectionType":["","blobs","measurements"],"circularityEnabled":[true]}},
