{
  "operatorId": "vision.collection.filter",
  "displayName": "Filter Collection",
  "version": "1.3.0",
  "entry": "emo_master.plugins.builtins.collection_filter.operator:CollectionFilterOperator",
  "category": "结果处理",
  "iconKey": "filter",
  "summary": "按类型字段及空间关系过滤强类型视觉集合。",
  "inputPorts": {
    "blobs": {"type": "blobCollection", "required": false, "nullable": false, "schemaVersion": "1.x"},
    "detections": {"type": "detectionCollection", "required": false, "nullable": false, "schemaVersion": "1.x"},
    "contours": {"type": "contourCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "measurements": {"type": "shapeMeasurementCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "lines": {"type": "lineCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "circles": {"type": "circleCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "matches": {"type": "templateMatchCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "roi": {"type": "geometry2d", "required": false, "nullable": false, "schemaVersion": "1.x"}
  },
  "outputPorts": {
    "keptCount": {"type": "integer", "required": true, "nullable": false},
    "rejectedCount": {"type": "integer", "required": true, "nullable": false},
    "keptBlobs": {"type": "blobCollection", "required": false, "nullable": false, "schemaVersion": "1.x"},
    "rejectedBlobs": {"type": "blobCollection", "required": false, "nullable": false, "schemaVersion": "1.x"},
    "keptDetections": {"type": "detectionCollection", "required": false, "nullable": false, "schemaVersion": "1.x"},
    "rejectedDetections": {"type": "detectionCollection", "required": false, "nullable": false, "schemaVersion": "1.x"},
    "keptContours": {"type": "contourCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "rejectedContours": {"type": "contourCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "keptMeasurements": {"type": "shapeMeasurementCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "rejectedMeasurements": {"type": "shapeMeasurementCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "keptLines": {"type": "lineCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "rejectedLines": {"type": "lineCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "keptCircles": {"type": "circleCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "rejectedCircles": {"type": "circleCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "keptMatches": {"type": "templateMatchCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "rejectedMatches": {"type": "templateMatchCollection", "required": false, "nullable": false, "schemaVersion": "1.2"}
  },
  "paramSchema": {
    "type": "object",
    "xCollectionFilter": true,
    "properties": {
      "collectionType": {
        "description": "筛选对象；为空时在执行阶段采用实际输入集合端口。",
        "title": "筛选对象",
        "type": "string",
        "default": "",
        "enum": [
          "",
          "detections",
          "blobs",
          "contours",
          "measurements",
          "lines",
          "circles",
          "matches"
        ],
        "xOptionLabels": {
          "": "请选择筛选对象",
          "detections": "检测结果",
          "blobs": "连通域",
          "contours": "轮廓",
          "measurements": "形状测量",
          "lines": "直线",
          "circles": "圆",
          "matches": "模板匹配结果"
        }
      },
      "areaEnabled": {
        "title": "面积筛选",
        "type": "boolean",
        "description": "开启后对连通域、轮廓、形状测量应用此组条件。关闭时保留编辑值，执行时忽略此组条件。",
        "xVisibleWhen": {
          "collectionType": [
            "blobs",
            "contours",
            "measurements"
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "blobs",
            "contours",
            "measurements"
          ]
        }
      },
      "minArea": {
        "description": "面积含下限，单位pixel²；Blob用已有area，轮廓用cv2.contourArea绝对值，measurement用已有area。",
        "title": "最小面积",
        "type": "number",
        "minimum": 0.0,
        "default": 0.0,
        "xVisibleWhen": {
          "collectionType": [
            "blobs",
            "contours",
            "measurements"
          ],
          "areaEnabled": [
            true
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "blobs",
            "contours",
            "measurements"
          ],
          "areaEnabled": [
            true
          ]
        }
      },
      "maxArea": {
        "description": "面积含上限，0表示无上限；来源同minArea。",
        "title": "最大面积",
        "type": "number",
        "minimum": 0.0,
        "default": 0.0,
        "xVisibleWhen": {
          "collectionType": [
            "blobs",
            "contours",
            "measurements"
          ],
          "areaEnabled": [
            true
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "blobs",
            "contours",
            "measurements"
          ],
          "areaEnabled": [
            true
          ]
        }
      },
      "contourPointsEnabled": {
        "title": "轮廓点数筛选",
        "type": "boolean",
        "description": "开启后对轮廓应用此组条件。关闭时保留编辑值，执行时忽略此组条件。",
        "xVisibleWhen": {
          "collectionType": [
            "contours"
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "contours"
          ]
        }
      },
      "minContourPoints": {
        "title": "最小轮廓点数",
        "type": "integer",
        "minimum": 0,
        "default": 0,
        "description": "当前轮廓polygon.points数量含下限；针对上游近似后顶点数，0不限制。",
        "xVisibleWhen": {
          "collectionType": [
            "contours"
          ],
          "contourPointsEnabled": [
            true
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "contours"
          ],
          "contourPointsEnabled": [
            true
          ]
        }
      },
      "perimeterEnabled": {
        "title": "周长筛选",
        "type": "boolean",
        "description": "开启后对轮廓、形状测量应用此组条件。关闭时保留编辑值，执行时忽略此组条件。",
        "xVisibleWhen": {
          "collectionType": [
            "contours",
            "measurements"
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "contours",
            "measurements"
          ]
        }
      },
      "minPerimeter": {
        "description": "轮廓闭合周长或measurement.perimeter的含下限，单位pixel。",
        "title": "最小周长",
        "type": "number",
        "minimum": 0.0,
        "default": 0.0,
        "xVisibleWhen": {
          "collectionType": [
            "contours",
            "measurements"
          ],
          "perimeterEnabled": [
            true
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "contours",
            "measurements"
          ],
          "perimeterEnabled": [
            true
          ]
        }
      },
      "maxPerimeter": {
        "description": "周长含上限，0表示无上限。",
        "title": "最大周长",
        "type": "number",
        "minimum": 0.0,
        "default": 0.0,
        "xVisibleWhen": {
          "collectionType": [
            "contours",
            "measurements"
          ],
          "perimeterEnabled": [
            true
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "contours",
            "measurements"
          ],
          "perimeterEnabled": [
            true
          ]
        }
      },
      "circularityEnabled": {
        "title": "圆度筛选",
        "type": "boolean",
        "description": "开启后对连通域、形状测量应用此组条件。关闭时保留编辑值，执行时忽略此组条件。",
        "xVisibleWhen": {
          "collectionType": [
            "blobs",
            "measurements"
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "blobs",
            "measurements"
          ]
        },
        "default": false
      },
      "minCircularity": {
        "description": "圆度含下限；Blob取attributes.circularity且字段缺失不通过已启用筛选，measurement取本身circularity。",
        "title": "最小圆度",
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0,
        "default": 0.0,
        "xVisibleWhen": {
          "collectionType": [
            "blobs",
            "measurements"
          ],
          "circularityEnabled": [
            true
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "blobs",
            "measurements"
          ],
          "circularityEnabled": [
            true
          ]
        }
      },
      "maxCircularity": {
        "description": "圆度含上限，1是实际上限而非无限哨兵；与minCircularity共同约束[0,1]。",
        "title": "最大圆度",
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0,
        "default": 1.0,
        "xVisibleWhen": {
          "collectionType": [
            "blobs",
            "measurements"
          ],
          "circularityEnabled": [
            true
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "blobs",
            "measurements"
          ],
          "circularityEnabled": [
            true
          ]
        }
      },
      "blobLabelsEnabled": {
        "title": "连通域标签筛选",
        "type": "boolean",
        "description": "开启后对连通域应用此组条件。关闭时保留编辑值，执行时忽略此组条件。",
        "xVisibleWhen": {
          "collectionType": [
            "blobs"
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "blobs"
          ]
        }
      },
      "blobLabels": {
        "description": "允许的连通域整数label列表；空列表不限制，按label而非blobId过滤。",
        "title": "连通域标签",
        "type": "array",
        "items": {
          "title": "列表项",
          "description": "列表单项：允许的连通域整数label列表；空列表不限制，按label而非blobId过滤。",
          "type": "integer",
          "minimum": 0
        },
        "default": [],
        "xVisibleWhen": {
          "collectionType": [
            "blobs"
          ],
          "blobLabelsEnabled": [
            true
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "blobs"
          ],
          "blobLabelsEnabled": [
            true
          ]
        },
        "xWidget": "integer-list"
      },
      "contourEnabled": {
        "title": "轮廓存在性筛选",
        "type": "boolean",
        "description": "开启后对连通域应用此组条件。关闭时保留编辑值，执行时忽略此组条件。",
        "xVisibleWhen": {
          "collectionType": [
            "blobs"
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "blobs"
          ]
        }
      },
      "contourMode": {
        "description": "any不限制；present要求Blob.contour非None；absent要求None。",
        "title": "轮廓筛选模式",
        "type": "string",
        "enum": [
          "any",
          "present",
          "absent"
        ],
        "default": "any",
        "xVisibleWhen": {
          "collectionType": [
            "blobs"
          ],
          "contourEnabled": [
            true
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "blobs"
          ],
          "contourEnabled": [
            true
          ]
        },
        "xOptionLabels": {
          "any": "不限",
          "present": "存在轮廓",
          "absent": "无轮廓"
        }
      },
      "confidenceEnabled": {
        "title": "置信度筛选",
        "type": "boolean",
        "description": "开启后对检测结果应用此组条件。关闭时保留编辑值，执行时忽略此组条件。",
        "xVisibleWhen": {
          "collectionType": [
            "detections"
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "detections"
          ]
        }
      },
      "minConfidence": {
        "description": "Detection.confidence含下限，范围[0,1]；不是框架执行成功概率。",
        "title": "最低置信度",
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0,
        "default": 0.0,
        "xVisibleWhen": {
          "collectionType": [
            "detections"
          ],
          "confidenceEnabled": [
            true
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "detections"
          ],
          "confidenceEnabled": [
            true
          ]
        }
      },
      "maxConfidence": {
        "description": "Detection.confidence含上限，默认1。",
        "title": "最高置信度",
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0,
        "default": 1.0,
        "xVisibleWhen": {
          "collectionType": [
            "detections"
          ],
          "confidenceEnabled": [
            true
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "detections"
          ],
          "confidenceEnabled": [
            true
          ]
        }
      },
      "classIdsEnabled": {
        "title": "类别编号筛选",
        "type": "boolean",
        "description": "开启后对检测结果应用此组条件。关闭时保留编辑值，执行时忽略此组条件。",
        "xVisibleWhen": {
          "collectionType": [
            "detections"
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "detections"
          ]
        }
      },
      "classIds": {
        "description": "允许的Detection.classId整数列表；空列表不限制。",
        "title": "类别编号",
        "type": "array",
        "items": {
          "title": "列表项",
          "description": "列表单项：允许的Detection.classId整数列表；空列表不限制。",
          "type": "integer",
          "minimum": 0
        },
        "default": [],
        "xVisibleWhen": {
          "collectionType": [
            "detections"
          ],
          "classIdsEnabled": [
            true
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "detections"
          ],
          "classIdsEnabled": [
            true
          ]
        },
        "xWidget": "integer-list"
      },
      "detectionLabelsEnabled": {
        "title": "检测标签筛选",
        "type": "boolean",
        "description": "开启后对检测结果应用此组条件。关闭时保留编辑值，执行时忽略此组条件。",
        "xVisibleWhen": {
          "collectionType": [
            "detections"
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "detections"
          ]
        }
      },
      "detectionLabels": {
        "description": "允许的Detection.label字符串列表；空列表不限制，精确匹配。",
        "title": "检测标签",
        "type": "array",
        "items": {
          "title": "列表项",
          "description": "列表单项：允许的Detection.label字符串列表；空列表不限制，精确匹配。",
          "type": "string"
        },
        "default": [],
        "xVisibleWhen": {
          "collectionType": [
            "detections"
          ],
          "detectionLabelsEnabled": [
            true
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "detections"
          ],
          "detectionLabelsEnabled": [
            true
          ]
        }
      },
      "geometryTypesEnabled": {
        "title": "几何类型筛选",
        "type": "boolean",
        "description": "开启后对检测结果应用此组条件。关闭时保留编辑值，执行时忽略此组条件。",
        "xVisibleWhen": {
          "collectionType": [
            "detections"
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "detections"
          ]
        }
      },
      "geometryTypes": {
        "description": "允许的检测几何类型列表；优先item.geometry，无geometry时用bbox；空列表不限制。",
        "title": "几何类型",
        "type": "array",
        "default": [],
        "items": {
          "title": "允许的几何类型",
          "description": "矩形框、多边形或旋转矩形框。",
          "type": "string",
          "enum": [
            "bbox2d",
            "polygon2d",
            "rotatedBox2d"
          ],
          "xOptionLabels": {
            "bbox2d": "矩形框",
            "polygon2d": "多边形",
            "rotatedBox2d": "旋转矩形框"
          }
        },
        "xVisibleWhen": {
          "collectionType": [
            "detections"
          ],
          "geometryTypesEnabled": [
            true
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "detections"
          ],
          "geometryTypesEnabled": [
            true
          ]
        },
        "xOptionLabels": {
          "bbox2d": "矩形框",
          "polygon2d": "多边形",
          "rotatedBox2d": "旋转矩形框"
        }
      },
      "holeEnabled": {
        "title": "孔洞筛选",
        "type": "boolean",
        "description": "开启后对轮廓应用此组条件。关闭时保留编辑值，执行时忽略此组条件。",
        "xVisibleWhen": {
          "collectionType": [
            "contours"
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "contours"
          ]
        }
      },
      "holeMode": {
        "description": "any不限；outer要求isHole=false；hole要求isHole=true。",
        "title": "孔洞筛选模式",
        "type": "string",
        "enum": [
          "any",
          "outer",
          "hole"
        ],
        "default": "any",
        "xVisibleWhen": {
          "collectionType": [
            "contours"
          ],
          "holeEnabled": [
            true
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "contours"
          ],
          "holeEnabled": [
            true
          ]
        },
        "xOptionLabels": {
          "any": "不限",
          "outer": "外轮廓",
          "hole": "孔洞轮廓"
        }
      },
      "sourceTypesEnabled": {
        "title": "来源类型筛选",
        "type": "boolean",
        "description": "开启后对形状测量应用此组条件。关闭时保留编辑值，执行时忽略此组条件。",
        "xVisibleWhen": {
          "collectionType": [
            "measurements"
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "measurements"
          ]
        }
      },
      "sourceTypes": {
        "description": "允许的ShapeMeasurement.sourceType（contour/blob）列表；空列表不限制。",
        "title": "来源类型",
        "type": "array",
        "default": [],
        "items": {
          "title": "允许的来源类型",
          "description": "形状测量的来源，可为轮廓或连通域。",
          "type": "string",
          "enum": [
            "contour",
            "blob"
          ],
          "xOptionLabels": {
            "contour": "轮廓",
            "blob": "连通域"
          }
        },
        "xVisibleWhen": {
          "collectionType": [
            "measurements"
          ],
          "sourceTypesEnabled": [
            true
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "measurements"
          ],
          "sourceTypesEnabled": [
            true
          ]
        },
        "xOptionLabels": {
          "contour": "轮廓",
          "blob": "连通域"
        }
      },
      "lengthEnabled": {
        "title": "长度筛选",
        "type": "boolean",
        "description": "开启后对直线应用此组条件。关闭时保留编辑值，执行时忽略此组条件。",
        "xVisibleWhen": {
          "collectionType": [
            "lines"
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "lines"
          ]
        }
      },
      "minLength": {
        "description": "Line两端欧氏距离含下限，单位pixel。",
        "title": "最小长度",
        "type": "number",
        "minimum": 0.0,
        "default": 0.0,
        "xVisibleWhen": {
          "collectionType": [
            "lines"
          ],
          "lengthEnabled": [
            true
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "lines"
          ],
          "lengthEnabled": [
            true
          ]
        }
      },
      "maxLength": {
        "description": "Line长度含上限，0无上限。",
        "title": "最大长度",
        "type": "number",
        "minimum": 0.0,
        "default": 0.0,
        "xVisibleWhen": {
          "collectionType": [
            "lines"
          ],
          "lengthEnabled": [
            true
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "lines"
          ],
          "lengthEnabled": [
            true
          ]
        }
      },
      "radiusEnabled": {
        "title": "半径筛选",
        "type": "boolean",
        "description": "开启后对圆应用此组条件。关闭时保留编辑值，执行时忽略此组条件。",
        "xVisibleWhen": {
          "collectionType": [
            "circles"
          ]
        },
        "xValidateWhen": {
          "collectionType": [
            "",
            "circles"
          ]
        }
      },
      "minRadius": {
        "description": "Circle.radius含下限，单位pixel。",
        "title": "最小半径（像素）",
        "type": "number",
        "minimum": 0.0,
        "default": 0.0,
        "xVisibleWhen": {
          "collectionType": [
            "circles"
          ],
          "radiusEnabled": [
            true
          ]
        },
