{
  "operatorId": "communication.coordinate_message_format",
  "displayName": "坐标报文格式化",
  "version": "1.0.0",
  "entry": "emo_master.plugins.builtins._managed_tcp:CoordinateMessageFormatOperator",
  "category": "通讯",
  "iconKey": "tcp-client",
  "summary": "坐标 round 后转文本，保留引号与后缀；默认兼容 LN5 正常 EY 报文。",
  "inputPorts": {
    "x": {
      "type": "number",
      "required": true,
      "nullable": false
    },
    "y": {
      "type": "number",
      "required": true,
      "nullable": false
    }
  },
  "outputPorts": {
    "data": {
      "type": "string",
      "required": true,
      "nullable": false
    }
  },
  "paramSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "decimals": {
        "title": "舍入小数位数",
        "type": "integer",
        "minimum": 0,
        "maximum": 9,
        "default": 3,
        "description": "X 与 Y 坐标使用同一小数精度，范围为 0 至 9 位。"
      },
      "numberFormat": {
        "title": "数值表示",
        "type": "string",
        "enum": [
          "round",
          "fixed"
        ],
        "default": "round",
        "description": "round 保留舍入后的常规表示，fixed 补零以保留指定小数位数。"
      },
      "quote": {
        "title": "包围引号",
        "type": "string",
        "enum": [
          "single",
          "double",
          "none"
        ],
        "default": "single",
        "description": "整段报文外围使用单引号、双引号或无引号。"
      },
      "suffix": {
        "title": "报文后缀",
        "type": "string",
        "default": "EY",
        "maxLength": 80,
        "description": "紧接 Y 坐标附加的文本，随后才添加右侧包围引号。"
      }
    }
  },
  "minCoreVersion": "0.6.1",
  "maxCoreVersion": "1.x",
  "resultSchema": {
    "inputs": {
      "x": {"title": "横坐标", "description": "有限 X 数值；不做坐标系或单位转换。"},
      "y": {"title": "纵坐标", "description": "有限 Y 数值；与 X 原样采用相同数值表示策略。"}
    },
    "outputs": {
      "data": {"title": "数据", "description": "把 X,Y 用逗号连接，追加 suffix 后再用 quote 包围的文本；不会自动追加换行。"}
    }
  }
}
