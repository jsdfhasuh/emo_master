{
  "operatorId": "vision.geometry.extract_points",
  "displayName": "几何特征取点",
  "version": "1.0.0",
  "inputPorts": {
    "circles": {
      "type": "circleCollection",
      "required": false,
      "nullable": false,
      "schemaVersion": "1.2"
    },
    "measurements": {
      "type": "shapeMeasurementCollection",
      "required": false,
      "nullable": false,
      "schemaVersion": "1.2"
    },
    "bbox": {
      "type": "bbox2d",
      "required": false,
      "nullable": false,
      "schemaVersion": "1.x"
    }
  },
  "outputPorts": {
    "points": {
      "type": "list<point2d>",
      "required": true,
      "nullable": false,
      "schemaVersion": "1.x"
    },
    "pointCount": {
      "type": "integer",
      "required": true,
      "nullable": false
    }
  },
  "paramSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "inputType": {
        "title": "处理对象",
        "type": "string",
        "enum": [
          "",
          "circles",
          "measurements",
          "bbox"
        ],
        "default": "",
        "description": "选择符合取点特征的输入对象；留空时由本次唯一提供的业务输入确定。",
        "xOptionLabels": {
          "": "请选择处理对象",
          "circles": "圆",
          "measurements": "形状测量",
          "bbox": "包围框"
        },
        "xEnumBy": {
          "parameter": "feature",
          "options": {
            "circleCenter": [
              "circles"
            ],
            "bboxCenter": [
              "bbox",
              "measurements"
            ],
            "bboxTopLeft": [
              "bbox",
              "measurements"
            ],
            "minAreaRectCenter": [
              "measurements"
            ],
            "centroid": [
              "measurements"
            ]
          }
        }
      },
      "feature": {
        "description": "circleCenter圆心；bboxCenter轴对齐框中心；bboxTopLeft左上角；minAreaRectCenter旋转矩形中心；centroid读取已有质心，不计算Blob内心。",
        "title": "取点特征",
        "type": "string",
        "default": "circleCenter",
        "enum": [
          "circleCenter",
          "bboxCenter",
          "bboxTopLeft",
          "minAreaRectCenter",
          "centroid"
        ],
        "xOptionLabels": {
          "circleCenter": "圆心",
          "bboxCenter": "轴对齐包围框中心",
          "bboxTopLeft": "轴对齐包围框左上角",
          "minAreaRectCenter": "最小面积旋转矩形中心",
          "centroid": "轮廓质心（不是 Blob 内心）"
        }
      }
    },
    "xModeOperator": "vision.geometry.extract_points"
  },
  "entry": "emo_master.plugins.builtins._geometry_bridges:GeometryPointsOperator",
  "category": "几何",
  "summary": "提取圆心、指定矩形特征或明确的质心；不推测 Blob 内心。",
  "minCoreVersion": "0.6.1",
  "maxCoreVersion": "1.x",
  "iconKey": "default",
  "resultSchema": {
    "inputs": {
      "circles": {"title": "圆", "description": "circleCenter模式读取每个圆的已有center；与其他候选端口互斥。"},
      "measurements": {"title": "形状测量", "description": "按feature从每个ShapeMeasurement读取bbox中心/左上角、minAreaRect中心或centroid。"},
      "bbox": {"title": "包围框", "description": "单个轴对齐框；仅bboxCenter或bboxTopLeft使用。"}
    },
    "outputs": {
      "points": {"title": "点集", "description": "实际提取的强类型点列表，顺序继承输入对象顺序，保持坐标空间。"},
      "pointCount": {"title": "点数量", "description": "points长度，空输入集合可返回0。", "unit": "个"}
    }
  }
}
