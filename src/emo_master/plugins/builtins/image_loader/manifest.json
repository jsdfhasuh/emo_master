{
  "operatorId": "vision.io.image_loader",
  "displayName": "Image Loader",
  "version": "1.1.0",
  "entry": "emo_master.plugins.builtins.image_loader.operator:ImageLoaderOperator",
  "category": "预处理",
  "iconKey": "source",
  "summary": "从本地路径读取图片，并输出 image 与带源路径标识的 frame。",
  "inputPorts": {},
  "outputPorts": {
    "image": {"type": "image", "required": true, "nullable": false},
    "frame": {
      "type": "bbox2d",
      "required": true,
      "nullable": false,
      "schemaVersion": "1.1"
    }
  },
  "paramSchema": {
    "type": "object",
    "properties": {
      "imagePath": {
        "type": "string",
        "default": "",
        "xWidget": "file",
        "xFileMode": "open",
        "xFilter": "图片文件 (*.png *.jpg *.jpeg *.bmp *.tif *.tiff)"
      },
      "colorMode": {
        "type": "string",
        "enum": ["color", "grayscale"],
        "default": "color"
      }
    },
    "required": ["imagePath"]
  },
  "minCoreVersion": "0.1.0",
  "maxCoreVersion": "1.x"
}
