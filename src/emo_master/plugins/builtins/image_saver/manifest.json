{
  "operatorId": "vision.io.image_saver",
  "displayName": "Image Saver",
  "version": "1.2.0",
  "entry": "emo_master.plugins.builtins.image_saver.operator:ImageSaverOperator",
  "category": "输出",
  "iconKey": "output",
  "summary": "将输入图像写出到本地路径，支持固定文件名或自动唯一命名，可通过 fileName 输入指定文件名主体。",
  "inputPorts": {
    "image": "image",
    "fileName": {
      "type": "string",
      "required": false,
      "nullable": false
    }
  },
  "outputPorts": {
    "result": "json"
  },
  "paramSchema": {
    "type": "object",
    "properties": {
      "outputPath": {
        "title": "输出路径",
        "description": "未连接 fileName 时使用完整路径；连接后使用此路径的所在目录，文件名由输入提供，未带扩展名时沿用此路径的扩展名。",
        "type": "string",
        "default": "",
        "xWidget": "file",
        "xFileMode": "save",
        "xFilter": "图片文件 (*.png *.jpg *.jpeg *.bmp *.tif *.tiff)"
      },
      "namingMode": {
        "title": "文件命名",
        "description": "固定名称沿用 outputPath 或 fileName 输入；自动唯一命名在该文件名主体后追加 UTC 时间和唯一标识，保留目录和扩展名，每次创建新文件，不覆盖已有文件。",
        "type": "string",
        "enum": ["fixed", "unique"],
        "default": "fixed",
        "xOptionLabels": {"fixed": "固定名称", "unique": "自动唯一命名"}
      },
      "overwrite": {
        "title": "覆盖已有文件",
        "description": "仅固定名称模式使用；自动唯一命名始终创建新文件。",
        "type": "boolean",
        "default": true,
        "xEnabledWhen": {"namingMode": ["fixed"]}
      }
    },
    "required": ["outputPath"]
  },
  "minCoreVersion": "0.1.0",
  "maxCoreVersion": "1.x"
}
