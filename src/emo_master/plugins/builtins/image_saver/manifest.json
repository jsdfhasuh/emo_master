{
  "operatorId": "vision.io.image_saver",
  "displayName": "Image Saver",
  "version": "1.1.0",
  "entry": "emo_master.plugins.builtins.image_saver.operator:ImageSaverOperator",
  "category": "输出",
  "iconKey": "output",
  "summary": "将输入图像写出到本地路径，可通过 fileName 输入逐张指定保存文件名。",
  "inputPorts": {
    "image": "image",
    "fileName": {
      "type": "string",
      "required": false,
      "nullable": false
    }
  },
  "outputPorts": {
    "result": "json"
  },
  "paramSchema": {
    "type": "object",
    "properties": {
      "outputPath": {
        "title": "输出路径",
        "description": "未连接 fileName 时使用完整路径；连接后使用此路径的所在目录，文件名由输入提供，未带扩展名时沿用此路径的扩展名。",
        "type": "string",
        "default": "",
        "xWidget": "file",
        "xFileMode": "save",
        "xFilter": "图片文件 (*.png *.jpg *.jpeg *.bmp *.tif *.tiff)"
      },
      "overwrite": {
        "title": "覆盖已有文件",
        "type": "boolean",
        "default": true
      }
    },
    "required": ["outputPath"]
  },
  "minCoreVersion": "0.1.0",
  "maxCoreVersion": "1.x"
}
