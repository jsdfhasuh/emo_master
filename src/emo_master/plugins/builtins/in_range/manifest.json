{
  "operatorId": "vision.segment.in_range",
  "displayName": "In Range",
  "version": "1.0.0",
  "entry": "emo_master.plugins.builtins.in_range.operator:InRangeOperator",
  "category": "分割",
  "iconKey": "range",
  "summary": "按 GRAY、BGR、RGB、HSV 或 OpenCV uint8 LAB 通道范围生成 0/255 掩码。",
  "inputPorts": {
    "image": {"type": "image", "required": true, "nullable": false},
    "frame": {
      "type": "bbox2d",
      "required": false,
      "nullable": false,
      "schemaVersion": "1.x"
    }
  },
  "outputPorts": {
    "mask": {"type": "image", "required": true, "nullable": false},
    "frame": {
      "type": "bbox2d",
      "required": true,
      "nullable": false,
      "schemaVersion": "1.x"
    }
  },
  "paramSchema": {
    "type": "object",
    "properties": {
      "colorSpace": {
        "title": "颜色空间",
        "type": "string",
        "enum": [
          "BGR",
          "RGB",
          "GRAY",
          "HSV",
          "LAB"
        ],
        "default": "BGR",
        "xOptionLabels": {
          "BGR": "蓝绿红（BGR）",
          "RGB": "红绿蓝（RGB）",
          "GRAY": "灰度（GRAY）",
          "HSV": "色调/饱和度/明度（HSV）",
          "LAB": "亮度/色度（LAB）"
        },
        "description": "声明输入色序并决定通道数和HSV色调上限；无cvtColor。"
      },
      "lower": {
        "title": "颜色下限",
        "type": "array",
        "items": {
          "title": "列表项",
          "description": "对应colorSpace通道的下限整数，顺序GRAY/BGR/RGB/HSV/LAB。",
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "xExample": [
          0,
          0,
          0
        ],
        "description": "每通道下限；GRAY1项，其他3项，逐项<=upper；HSV第一项<=179。"
      },
      "upper": {
        "title": "颜色上限",
        "type": "array",
        "items": {
          "title": "列表项",
          "description": "对应colorSpace通道的上限整数；HSV H为0..179。",
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "xExample": [
          255,
          255,
          255
        ],
        "description": "每通道上限；同lower长度/范围，包含边界。"
      }
    },
    "required": [
      "lower",
      "upper"
    ],
    "xChannelBounds": {
      "selector": "colorSpace",
      "lower": "lower",
      "upper": "upper",
      "maxima": {
        "GRAY": [
          255
        ],
        "BGR": [
          255,
          255,
          255
        ],
        "RGB": [
          255,
          255,
          255
        ],
        "HSV": [
          179,
          255,
          255
        ],
        "LAB": [
          255,
          255,
          255
        ]
      }
    }
  },
  "minCoreVersion": "0.2.0",
  "maxCoreVersion": "1.x",
  "resultSchema": {
    "inputs": {
      "image": {"title": "图像", "description": "uint8图像；colorSpace必须与已有色序一致，不做颜色转换。"},
      "frame": {"title": "坐标框", "description": "输入图像有效内容矩形与回源坐标；缺失默认全图。"}
    },
    "outputs": {
      "mask": {"title": "掩膜", "description": "各通道值同时落在下限/上限闭区间的0/255掩码。"},
      "frame": {"title": "坐标框", "description": "规范化输入frame透传。"}
    },
    "metrics": {
      "latencyMs": {
        "title": "算子内部耗时",
        "description": "从入口到cv2.inRange完成的内部耗时，不含随后count_nonzero。",
        "unit": "ms",
        "group": "duration"
      },
      "foregroundPixels": {"title": "前景像素数", "description": "全mask非零像素数。", "unit": "像素", "group": "business"},
      "colorSpace": {"title": "颜色空间", "description": "声明并用于范围校验的实际色序。", "group": "parameter"}
    },
    "diagnostics": {
      "text": {"title": "摘要", "description": "实际色序的范围分割摘要。"}
    }
  }
}
