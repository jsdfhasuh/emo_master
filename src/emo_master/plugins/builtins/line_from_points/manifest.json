{
  "operatorId": "vision.geometry.line_from_points",
  "displayName": "两点生成线段",
  "version": "1.0.0",
  "entry": "emo_master.plugins.builtins._geometry_bridges:LineFromPointsOperator",
  "category": "几何",
  "iconKey": "default",
  "summary": "连接两个已选单点；任一端为空时输出空线段集合，沿用当前 frame 的坐标空间。",
  "inputPorts": {
    "startPoints": {"type": "list<point2d>", "required": true, "nullable": false, "schemaVersion": "1.x"},
    "endPoints": {"type": "list<point2d>", "required": true, "nullable": false, "schemaVersion": "1.x"},
    "frame": {"type": "bbox2d", "required": true, "nullable": false, "schemaVersion": "1.x"}
  },
  "outputPorts": {
    "lines": {"type": "lineCollection", "required": true, "nullable": false, "schemaVersion": "1.2"},
    "lineCount": {"type": "integer", "required": true, "nullable": false}
  },
  "paramSchema": {"type": "object", "properties": {}, "additionalProperties": false},
  "minCoreVersion": "0.6.1",
  "maxCoreVersion": "1.x",
  "resultSchema": {
    "inputs": {
      "startPoints": {"title": "起点", "description": "已选起点列表，允许0或1个点；超过1报错，非空点须与frame坐标空间相同。"},
      "endPoints": {"title": "终点", "description": "已选终点列表，允许0或1个点；超过1报错，非空点须与frame坐标空间相同。"},
      "frame": {"title": "坐标框", "description": "确定输出集合坐标空间，包括空结果；不把bbox边缘自动当作端点。"}
    },
    "outputs": {
      "lines": {"title": "线段", "description": "两端均存在时返回ID=segment的一条线段；任一端为空则返回同frame空间的空集合。"},
      "lineCount": {"title": "线段数量", "description": "输出线段数量，为0或1。", "unit": "条"}
    }
  }
}
