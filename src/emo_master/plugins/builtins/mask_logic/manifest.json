{
  "operatorId": "vision.mask.logic",
  "displayName": "Mask Logic",
  "version": "1.0.0",
  "entry": "emo_master.plugins.builtins.mask_logic.operator:MaskLogicOperator",
  "category": "分割",
  "iconKey": "mask-logic",
  "summary": "对一个或两个同尺寸二值掩码执行 AND、OR、XOR、NOT 或差集。",
  "inputPorts": {
    "maskA": {"type": "image", "required": true, "nullable": false},
    "maskB": {"type": "image", "required": false, "nullable": false},
    "frameA": {
      "type": "bbox2d",
      "required": false,
      "nullable": false,
      "schemaVersion": "1.x"
    },
    "frameB": {
      "type": "bbox2d",
      "required": false,
      "nullable": false,
      "schemaVersion": "1.x"
    }
  },
  "outputPorts": {
    "mask": {"type": "image", "required": true, "nullable": false},
    "frame": {
      "type": "bbox2d",
      "required": true,
      "nullable": false,
      "schemaVersion": "1.x"
    }
  },
  "paramSchema": {
    "type": "object",
    "properties": {
      "operation": {
        "title": "操作类型",
        "type": "string",
        "enum": [
          "and",
          "or",
          "xor",
          "not",
          "subtract"
        ],
        "default": "and",
        "xOptionLabels": {
          "and": "交集（与）",
          "or": "并集（或）",
          "xor": "异或",
          "not": "取反",
          "subtract": "差集（A 减 B）"
        },
        "description": "二值集合运算；not只需A，其余需要B。"
      }
    }
  },
  "minCoreVersion": "0.2.0",
  "maxCoreVersion": "1.x",
  "resultSchema": {
    "inputs": {
      "maskA": {"title": "A 掩膜", "description": "必需非空二维uint8掩码，非零先归一化为255。"},
      "maskB": {"title": "B 掩膜", "description": "除not外必须提供，同shape；not分支不使用。"},
      "frameA": {"title": "A 图像坐标框", "description": "A掩码有效矩形/坐标；缺失默认全图。"},
      "frameB": {"title": "B 图像坐标框", "description": "二元操作可选；缺失沿用frameA，提供时须同空间并与A矩形求交。"}
    },
    "outputs": {
      "mask": {"title": "掩膜", "description": "and/or/xor/not/subtract(A与非B)所得0/255掩码。"},
      "frame": {"title": "坐标框", "description": "not沿用A；其余取A/B有效矩形交集，即使or也不是矩形并集。"}
    },
    "metrics": {
      "latencyMs": {"title": "算子内部耗时", "description": "输入检查、归一化及逻辑运算的内部耗时，不含后续前景计数。", "unit": "ms", "group": "duration"},
      "operation": {"title": "操作", "description": "实际执行的操作名。", "group": "parameter"},
      "foregroundPixels": {"title": "前景像素数", "description": "结果mask全图非零像素数。", "unit": "像素", "group": "business"}
    },
    "diagnostics": {
      "text": {"title": "摘要", "description": "实际操作的完成摘要。"}
    }
  }
}
