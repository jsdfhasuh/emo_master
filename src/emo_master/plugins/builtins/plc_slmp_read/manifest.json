{
  "operatorId": "communication.plc.slmp_read",
  "displayName": "PLC SLMP Read",
  "version": "1.1.0",
  "entry": "emo_master.plugins.builtins._communication_operators:PlcSlmpReadOperator",
  "category": "通讯",
  "iconKey": "plc-read",
  "summary": "通过三菱 SLMP/MC 3E 二进制协议有界读取 D/M 设备数据。",
  "inputPorts": {},
  "outputPorts": {
    "values": {"type": "plcValueCollection", "required": true, "nullable": false, "schemaVersion": "1.x"},
    "numberValue": {"type": "number", "required": false, "nullable": false},
    "booleanValue": {"type": "boolean", "required": false, "nullable": false}
  },
  "paramSchema": {
    "type": "object",
    "properties": {
      "host": {"title": "主机地址", "type": "string", "default": "127.0.0.1"},
      "port": {"title": "端口", "type": "integer", "minimum": 1, "maximum": 65535, "default": 10001},
      "device": {"title": "PLC 软元件", "type": "string", "enum": ["D", "M", "d", "m"], "default": "D"},
      "startAddress": {"title": "起始地址", "type": "integer", "minimum": 0, "maximum": 16777215, "default": 0},
      "connectTimeoutMs": {"title": "连接超时（毫秒）", "type": "integer", "minimum": 1, "maximum": 60000, "default": 2000},
      "responseTimeoutMs": {"title": "响应超时（毫秒）", "type": "integer", "minimum": 1, "maximum": 60000, "default": 2000},
      "retryCount": {"title": "异常重试次数", "type": "integer", "minimum": 0, "maximum": 3, "default": 1},
      "retryDelayMs": {"title": "重试间隔（毫秒）", "type": "integer", "minimum": 0, "maximum": 10000, "default": 0},
      "networkNo": {"title": "网络编号", "type": "integer", "minimum": 0, "maximum": 255, "default": 0},
      "pcNo": {"title": "PC 编号", "type": "integer", "minimum": 0, "maximum": 255, "default": 255},
      "moduleIoNo": {"title": "模块 I/O 编号", "type": "integer", "minimum": 0, "maximum": 65535, "default": 1023},
      "moduleStationNo": {"title": "模块站号", "type": "integer", "minimum": 0, "maximum": 255, "default": 0},
      "monitoringTimer": {"title": "监视定时器（250 毫秒单位）", "type": "integer", "minimum": 0, "maximum": 65535, "default": 0},
      "dataType": {"title": "数据类型", "type": "string", "enum": ["uint16", "int16", "uint32", "int32", "float32", "bit"], "default": "uint16"},
      "count": {"title": "数量", "type": "integer", "minimum": 1, "maximum": 960, "default": 1},
      "outputIndex": {"title": "输出值索引", "type": "integer", "minimum": 0, "maximum": 959, "default": 0}
    }
  },
  "minCoreVersion": "0.3.0",
  "maxCoreVersion": "1.x",
  "editor": {
    "schemaVersion": "1.0",
    "kind": "customUi",
    "openMode": "window",
    "uiResource": "ui/editor.ui",
    "controllerEntry": "emo_master.plugins.builtins._plc_editor:PlcEditorController",
    "fallback": "schemaForm",
    "previewMode": "none"
  }
}
