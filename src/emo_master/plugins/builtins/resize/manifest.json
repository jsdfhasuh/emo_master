{
  "nextCycleParameterPaths": ["width","height","mode","interpolation"],
  "operatorId": "vision.preprocess.resize",
  "displayName": "Resize / Letterbox",
  "version": "1.0.0",
  "entry": "emo_master.plugins.builtins.resize.operator:ResizeOperator",
  "category": "预处理",
  "iconKey": "resize",
  "summary": "拉伸、等比缩放或 Letterbox 图像，并输出可回源的有效内容 frame。",
  "inputPorts": {
    "image": {
      "type": "image",
      "required": true,
      "nullable": false
    },
    "frame": {
      "type": "bbox2d",
      "required": false,
      "nullable": false,
      "schemaVersion": "1.x"
    }
  },
  "outputPorts": {
    "image": {
      "type": "image",
      "required": true,
      "nullable": false
    },
    "frame": {
      "type": "bbox2d",
      "required": true,
      "nullable": false,
      "schemaVersion": "1.x"
    }
  },
  "paramSchema": {
    "type": "object",
    "properties": {
      "width": {
        "description": "目标宽；fit时实际输出宽可能更小，stretch/letterbox输出目标宽。",
        "title": "宽度（像素）",
        "type": "integer",
        "minimum": 1
      },
      "height": {
        "description": "目标高；fit时实际输出高可能更小，stretch/letterbox输出目标高。",
        "title": "高度（像素）",
        "type": "integer",
        "minimum": 1
      },
      "mode": {
        "description": "stretch各向拉伸；fit等比放入目标边界不加边；letterbox等比居中加边到目标大小。",
        "title": "缩放模式",
        "type": "string",
        "enum": [
          "stretch",
          "fit",
          "letterbox"
        ],
        "default": "stretch"
      },
      "interpolation": {
        "description": "图像缩放插值nearest/linear/area/cubic。",
        "title": "插值方式",
        "type": "string",
        "enum": [
          "nearest",
          "linear",
          "area",
          "cubic"
        ],
        "default": "linear"
      },
      "padValue": {
        "description": "仅letterbox的四周填充值；三通道显式重复为三元组。",
        "title": "填充值",
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "default": 0,
        "xVisibleWhen": {
          "mode": [
            "letterbox"
          ]
        },
        "xValidateWhen": {
          "mode": [
            "letterbox"
          ]
        }
      }
    },
    "required": [
      "width",
      "height"
    ],
    "xModeOperator": "vision.preprocess.resize"
  },
  "minCoreVersion": "0.2.0",
  "maxCoreVersion": "1.x",
  "resultSchema": {
    "inputs": {
      "image": {"title": "图像", "description": "uint8灰度/BGR输入。"},
      "frame": {"title": "坐标框", "description": "输入有效内容矩形和回源坐标。"}
    },
    "outputs": {
      "image": {"title": "图像", "description": "按mode缩放/填边的图像，实际尺寸见outputWidth/Height。"},
      "frame": {"title": "坐标框", "description": "按实际scale与padding变换后的有效内容矩形、复合回源坐标。"}
    },
    "metrics": {
      "latencyMs": {"title": "算子内部耗时", "description": "执行入口到返回前，包含验证和frame构建的内部耗时。", "unit": "ms", "group": "duration"},
      "mode": {"title": "模式", "description": "实际缩放模式。", "group": "parameter"},
      "sourceWidth": {"title": "源图宽度", "description": "输入图像宽。", "unit": "像素", "group": "result"},
      "sourceHeight": {"title": "源图高度", "description": "输入图像高。", "unit": "像素", "group": "result"},
      "outputWidth": {"title": "输出宽度", "description": "实际返回图像宽；fit未必等于配置width。", "unit": "像素", "group": "result"},
      "outputHeight": {"title": "输出高度", "description": "实际返回图像高；fit未必等于配置height。", "unit": "像素", "group": "result"},
      "scaleX": {"title": "横向缩放比例", "description": "有效缩放内容宽/源宽。", "unit": "比例", "group": "result"},
      "scaleY": {"title": "纵向缩放比例", "description": "有效缩放内容高/源高；舍入后可能略不同。", "unit": "比例", "group": "result"},
      "padding": {"title": "填充像素", "description": "实际左、上、右、下padding数组。", "unit": "像素", "group": "result"}
    },
    "diagnostics": {
      "text": {"title": "摘要", "description": "实际mode的完成摘要。"}
    }
  }
}
