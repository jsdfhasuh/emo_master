{
  "operatorId": "vision.io.result_writer",
  "displayName": "Result Writer",
  "version": "1.1.0",
  "entry": "emo_master.plugins.builtins.result_writer.operator:ResultWriterOperator",
  "category": "输入输出",
  "iconKey": "save",
  "summary": "将强类型视觉结果或基础值安全写入 Job 工作区的 JSON、JSONL 或 CSV 文件。",
  "inputPorts": {
    "blobs": {"type": "blobCollection", "required": false, "nullable": false, "schemaVersion": "1.x"},
    "detections": {"type": "detectionCollection", "required": false, "nullable": false, "schemaVersion": "1.x"},
    "contours": {"type": "contourCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "measurements": {"type": "shapeMeasurementCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "histogram": {"type": "histogram", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "lines": {"type": "lineCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "circles": {"type": "circleCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "matches": {"type": "templateMatchCollection", "required": false, "nullable": false, "schemaVersion": "1.2"},
    "statistics": {"type": "colorStatistics", "required": false, "nullable": false, "schemaVersion": "1.x"},
    "geometry": {"type": "geometry2d", "required": false, "nullable": false, "schemaVersion": "1.x"},
    "numberValue": {"type": "number", "required": false, "nullable": false},
    "booleanValue": {"type": "boolean", "required": false, "nullable": false},
    "stringValue": {"type": "string", "required": false, "nullable": false}
  },
  "outputPorts": {
    "result": {"type": "json", "required": true, "nullable": false}
  },
  "paramSchema": {
    "type": "object",
    "properties": {
      "inputType": {
        "title": "处理对象",
        "type": "string",
        "enum": [
          "",
          "detections",
          "blobs",
          "contours",
          "measurements",
          "lines",
          "circles",
          "matches",
          "histogram",
          "statistics",
          "geometry",
          "numberValue",
          "booleanValue",
          "stringValue"
        ],
        "default": "",
        "xOptionLabels": {
          "": "请选择处理对象",
          "detections": "检测结果",
          "blobs": "连通域",
          "contours": "轮廓",
          "measurements": "形状测量",
          "lines": "直线",
          "circles": "圆",
          "matches": "模板匹配结果",
          "histogram": "直方图",
          "statistics": "颜色统计",
          "geometry": "几何对象",
          "numberValue": "数值",
          "booleanValue": "布尔值",
          "stringValue": "文本"
        }
      },
      "format": {
        "title": "输出格式",
        "type": "string",
        "enum": [
          "json",
          "jsonl",
          "csv"
        ],
        "default": "json"
      },
      "relativePath": {
        "title": "相对输出路径",
        "type": "string",
        "default": "results/result"
      },
      "overwrite": {
        "title": "覆盖已有文件",
        "type": "boolean",
        "default": false
      }
    },
    "xModeOperator": "vision.io.result_writer"
  },
  "minCoreVersion": "0.3.0",
  "maxCoreVersion": "1.x"
}
