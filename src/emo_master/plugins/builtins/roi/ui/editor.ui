       <item><widget class="QLabel" name="sourceTitle"><property name="text"><string>原图 / 区域选择</string></property></widget></item>
       <item><widget class="QWidget" name="sourceTools"><layout class="QHBoxLayout" name="sourceToolsLayout"/></widget></item>
       <item><layout class="QHBoxLayout" name="newPurposeLayout"><item><widget class="QLabel" name="newPurposeLabel"><property name="text"><string>新建用途</string></property></widget></item><item><widget class="QComboBox" name="newPurposeCombo"/></item></layout></item>
       <item><widget class="QWidget" name="canvasPlaceholder"><layout class="QVBoxLayout" name="canvasLayout"/></widget></item>
