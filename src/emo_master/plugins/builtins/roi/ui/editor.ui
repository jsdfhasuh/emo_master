        <property name="tabPosition"><enum>QTabWidget::South</enum></property>
        <property name="usesScrollButtons"><bool>true</bool></property>
        <widget class="QWidget" name="croppedImagePage"><attribute name="title"><string>裁剪图像</string></attribute><layout class="QVBoxLayout" name="croppedImageLayout"/></widget>
        <widget class="QWidget" name="maskedImagePage"><attribute name="title"><string>遮罩图像</string></attribute><layout class="QVBoxLayout" name="maskedImageLayout"/></widget>
        <widget class="QWidget" name="croppedMaskPage"><attribute name="title"><string>裁剪掩膜</string></attribute><layout class="QVBoxLayout" name="croppedMaskLayout"/></widget>
        <widget class="QWidget" name="fullMaskPage"><attribute name="title"><string>原图掩膜</string></attribute><layout class="QVBoxLayout" name="fullMaskLayout"/></widget>
       </widget></item>
      </layout>
     </widget>
    </widget>
