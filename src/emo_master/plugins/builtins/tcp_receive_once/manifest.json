{
  "operatorId": "communication.tcp.receive_once",
  "displayName": "TCP Receive Once",
  "version": "1.1.0",
  "entry": "emo_master.plugins.builtins._communication_operators:TcpReceiveOnceOperator",
  "category": "通讯",
  "iconKey": "tcp-receive",
  "summary": "在有界超时内监听并接收一个 TCP 客户端的一条完整消息。",
  "inputPorts": {},
  "outputPorts": {
    "message": {"type": "tcpMessage", "required": true, "nullable": false, "schemaVersion": "1.x"},
    "peerHost": {"type": "string", "required": true, "nullable": false},
    "peerPort": {"type": "integer", "required": true, "nullable": false},
    "text": {"type": "string", "required": false, "nullable": false}
  },
  "paramSchema": {
    "type": "object",
    "properties": {
      "bindHost": {"title": "监听地址", "type": "string", "default": "127.0.0.1"},
      "port": {"title": "端口", "type": "integer", "minimum": 1, "maximum": 65535, "default": 10001},
      "acceptTimeoutMs": {"title": "等待连接超时（毫秒）", "type": "integer", "minimum": 1, "maximum": 60000, "default": 5000},
      "readTimeoutMs": {"title": "读取超时（毫秒）", "type": "integer", "minimum": 1, "maximum": 60000, "default": 1000},
      "framing": {"title": "消息分帧方式", "type": "string", "enum": ["newline", "quoted", "idle", "fixedLength"], "default": "newline"},
      "expectedBytes": {"title": "预期字节数", "type": "integer", "minimum": 0, "maximum": 16777216, "default": 0},
      "maxMessageBytes": {"title": "最大消息大小（字节）", "type": "integer", "minimum": 1, "maximum": 16777216, "default": 1048576},
      "messageEncoding": {"title": "消息内容编码", "type": "string", "enum": ["utf-8", "ascii", "latin-1", "hex", "base64"], "default": "utf-8"},
      "messageTextEncoding": {"title": "消息文本编码", "type": "string", "enum": ["none", "utf-8", "ascii", "latin-1"], "default": "none"},
      "ackText": {"title": "应答文本", "type": "string", "default": ""},
      "ackEncoding": {"title": "应答文本编码", "type": "string", "enum": ["utf-8", "ascii", "latin-1", "hex", "base64"], "default": "utf-8"},
      "ackAppendNewline": {"title": "应答追加换行", "type": "boolean", "default": true},
      "maxAckBytes": {"title": "最大应答大小（字节）", "type": "integer", "minimum": 1, "maximum": 16777216, "default": 1048576}
    }
  },
  "minCoreVersion": "0.3.0",
  "maxCoreVersion": "1.x"
}
