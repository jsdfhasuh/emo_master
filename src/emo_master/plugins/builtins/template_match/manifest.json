{
  "operatorId": "vision.analysis.template_match",
  "displayName": "Template Matching",
  "version": "1.0.0",
  "entry": "emo_master.plugins.builtins._detection_operators:TemplateMatchingOperator",
  "category": "分析",
  "iconKey": "template-match",
  "summary": "对第二个图像端口提供的模板执行单尺度匹配、局部峰值提取与 NMS。",
  "inputPorts": {
    "image": {"type": "image", "required": true, "nullable": false},
    "template": {"type": "image", "required": true, "nullable": false},
    "frame": {"type": "bbox2d", "required": false, "nullable": false, "schemaVersion": "1.x"},
    "roi": {"type": "geometry2d", "required": false, "nullable": false, "schemaVersion": "1.x"}
  },
  "outputPorts": {
    "matches": {"type": "templateMatchCollection", "required": true, "nullable": false, "schemaVersion": "1.2"},
    "frame": {"type": "bbox2d", "required": true, "nullable": false, "schemaVersion": "1.x"}
  },
  "paramSchema": {
    "type": "object",
    "properties": {
      "method": {"title": "匹配方法", "type": "string", "enum": ["sqdiff", "sqdiffNormed", "ccorr", "ccorrNormed", "ccoeff", "ccoeffNormed"], "default": "ccoeffNormed"},
      "colorMode": {"title": "颜色模式", "type": "string", "enum": ["gray", "native"], "default": "gray"},
      "thresholdMode": {"title": "阈值模式", "type": "string", "enum": ["quality", "raw"], "default": "quality"},
      "threshold": {"title": "阈值", "type": "number", "default": 0.8},
      "peakKernelSize": {"title": "峰值搜索核大小", "type": "integer", "minimum": 1, "maximum": 31, "default": 3},
      "nmsIouThreshold": {"title": "非极大值抑制 IoU 阈值", "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.3},
      "maxMatches": {"title": "最大匹配数量", "type": "integer", "minimum": 1, "maximum": 10000, "default": 100},
      "label": {"title": "匹配标签", "type": "string", "default": "template"}
    }
  },
  "minCoreVersion": "0.3.0",
  "maxCoreVersion": "1.x"
}
