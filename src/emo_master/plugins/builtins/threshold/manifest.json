{
  "nextCycleParameterPaths": ["mode","threshold","invert","blockSize","constant"],
  "operatorId": "vision.preprocess.threshold",
  "displayName": "Threshold",
  "version": "1.1.0",
  "entry": "emo_master.plugins.builtins.threshold.operator:ThresholdOperator",
  "category": "预处理",
  "iconKey": "threshold",
  "summary": "将 uint8 灰度或 BGR 图像转换为可复用的 0/255 二值掩码。",
  "inputPorts": {
    "image": {
      "type": "image",
      "required": true,
      "nullable": false
    },
    "frame": {
      "type": "bbox2d",
      "required": false,
      "nullable": false,
      "schemaVersion": "1.x"
    }
  },
  "outputPorts": {
    "mask": {
      "type": "image",
      "required": true,
      "nullable": false
    },
    "threshold": {
      "type": "number",
      "required": true,
      "nullable": true
    },
    "frame": {
      "type": "bbox2d",
      "required": true,
      "nullable": false,
      "schemaVersion": "1.x"
    }
  },
  "paramSchema": {
    "type": "object",
    "properties": {
      "mode": {
        "title": "阈值模式",
        "type": "string",
        "enum": [
          "fixed",
          "otsu",
          "triangle",
          "adaptiveMean",
          "adaptiveGaussian"
        ],
        "default": "fixed",
        "xOptionLabels": {
          "fixed": "固定阈值",
          "otsu": "大津法（自动阈值）",
          "triangle": "三角法（自动阈值）",
          "adaptiveMean": "自适应均值",
          "adaptiveGaussian": "自适应高斯"
        },
        "description": "fixed手动、otsu/triangle自动单阈值、adaptiveMean/adaptiveGaussian局部阈值。"
      },
      "threshold": {
        "title": "阈值",
        "type": "integer",
        "default": 127,
        "xMinimum": 0,
        "xMaximum": 255,
        "xEnabledWhen": {
          "mode": [
            "fixed"
          ]
        },
        "xUnit": "灰度级",
        "xExample": 127,
        "description": "仅fixed分支的灰度阈值0..255。"
      },
      "invert": {
        "title": "反向阈值",
        "type": "boolean",
        "default": false,
        "description": "决定THRESH_BINARY_INV或THRESH_BINARY；输出仍0/255。"
      },
      "blockSize": {
        "title": "自适应邻域大小",
        "type": "integer",
        "default": 11,
        "xMinimum": 3,
        "xOdd": true,
        "xEnabledWhen": {
          "mode": [
            "adaptiveMean",
            "adaptiveGaussian"
          ]
        },
        "xUnit": "像素",
        "xExample": 11,
        "description": "仅自适应模式的邻域边长，奇数>=3。"
      },
      "constant": {
        "title": "自适应阈值偏移量",
        "type": "number",
        "default": 2.0,
        "xEnabledWhen": {
          "mode": [
            "adaptiveMean",
            "adaptiveGaussian"
          ]
        },
        "xUnit": "灰度级",
        "xExample": 2.0,
        "description": "仅自适应模式的局部阈值减数，有限数，可负。"
      }
    }
  },
  "minCoreVersion": "0.2.0",
  "maxCoreVersion": "1.x",
  "resultSchema": {
    "inputs": {
      "image": {"title": "图像", "description": "uint8灰度或BGR图像。"},
      "frame": {"title": "坐标框", "description": "输入图像有效内容矩形与回源坐标；缺失默认全图。"}
    },
    "outputs": {
      "mask": {"title": "掩膜", "description": "固定/自动/自适应阈值所得单通道0/255图。"},
      "threshold": {"title": "阈值", "description": "固定/otsu/triangle返回OpenCV实际单值阈值；自适应返回null，不能把null当0。"},
      "frame": {"title": "坐标框", "description": "规范化输入frame透传。"}
    },
    "metrics": {
      "latencyMs": {"title": "算子内部耗时", "description": "从执行入口到阈值计算完成；前景统计在结束计时之后。", "unit": "ms", "group": "duration"},
      "foregroundPixels": {"title": "前景像素数", "description": "整个输出mask非零像素数；未按frame裁去无效内容。", "unit": "像素", "group": "business"},
      "foregroundRatio": {"title": "前景像素比例", "description": "非零像素数/整个mask元素数。", "unit": "比例", "group": "business"},
      "mode": {"title": "模式", "description": "实际阈值模式。", "group": "parameter"},
      "threshold": {"title": "阈值", "description": "与outputs.threshold相同的实际单阈值或null。", "unit": "灰度级或null", "group": "result"}
    },
    "diagnostics": {
      "text": {"title": "摘要", "description": "包含实际mode的完成摘要。"}
    }
  }
}
