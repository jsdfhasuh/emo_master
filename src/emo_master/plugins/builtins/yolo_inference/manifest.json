{
  "operatorId": "vision.inference.yolo",
  "displayName": "YOLO Inference",
  "version": "1.4.0",
  "entry": "emo_master.plugins.builtins.yolo_inference.operator:YoloInferenceOperator",
  "category": "推理",
  "iconKey": "yolo",
  "iconResource": "assets/icon.svg",
  "summary": "使用 ONNX Runtime CPU 执行 YOLOv8/YOLO11 目标检测，按置信度降序输出检测集合，可选择目标输出检测框裁剪图。",
  "inputPorts": {
    "image": {
      "type": "image",
      "required": true,
      "nullable": false
    },
    "frame": {
      "type": "bbox2d",
      "required": false,
      "nullable": false,
      "schemaVersion": "1.x"
    }
  },
  "outputPorts": {
    "detections": {
      "type": "detectionCollection",
      "required": true,
      "schemaVersion": "1.x"
    },
    "overlay": {
      "type": "image",
      "required": false
    },
    "croppedImage": {
      "type": "image",
      "required": false,
      "nullable": false
    },
    "croppedFrame": {
      "type": "bbox2d",
      "required": false,
      "nullable": false,
      "schemaVersion": "1.x"
    },
    "frame": {
      "type": "bbox2d",
      "required": true,
      "nullable": false,
      "schemaVersion": "1.x"
    }
  },
  "paramSchema": {
    "type": "object",
    "properties": {
      "modelPath": {
        "title": "模型路径",
        "type": "string",
        "default": "",
        "xWidget": "file",
        "xFileMode": "open",
        "xFilter": "YOLO ONNX 模型 (*.onnx)"
      },
      "confidence": {
        "title": "置信度阈值",
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.25,
        "xExample": 0.25,
        "description": "保留置信度不低于此值的检测结果，范围为 0～1。"
      },
      "iou": {
        "title": "非极大值抑制 IoU 阈值",
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.45,
        "xExample": 0.45,
        "description": "非极大值抑制的交并比阈值，范围为 0～1。"
      },
      "imageSize": {
        "title": "推理图像尺寸",
        "type": "integer",
        "minimum": 1,
        "default": 640,
        "xUnit": "像素",
        "xExample": 640,
        "description": "模型输入的目标图像尺寸，填写正整数。"
      },
      "maxDetections": {
        "title": "最大检测数量",
        "type": "integer",
        "minimum": 1,
        "default": 300,
        "xUnit": "个",
        "xExample": 300,
        "description": "单次推理最多保留的检测结果数量。"
      },
      "device": {
        "title": "推理设备",
        "type": "string",
        "enum": [
          "auto",
          "cpu"
        ],
        "default": "auto",
        "xOptionLabels": {
          "auto": "自动（当前使用 CPU）",
          "cpu": "CPU"
        },
        "description": "当前 ONNX 推理使用 CPU 执行提供程序。"
      },
      "classes": {
        "title": "检测类别（可选）",
        "description": "留空表示检测模型支持的全部类别；填写 0, 1 等类别编号时仅保留指定类别，也可粘贴 [0, 1]。类别名称由模型决定。",
        "type": "array",
        "xWidget": "integer-list",
        "xPlaceholder": "全部类别",
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "default": [],
        "xBlankMeansEmpty": true,
        "xExample": [
          0,
          1
        ]
      },
      "agnosticNms": {
        "title": "不区分类别的非极大值抑制",
        "type": "boolean",
        "default": false
      },
      "drawOverlay": {
        "title": "绘制叠加图",
        "type": "boolean",
        "default": true
      },
      "outputCrop": {
        "title": "输出裁剪图",
        "type": "boolean",
        "default": false,
        "description": "输出所选检测框内的原始像素和裁剪坐标框；不是分割掩码，也不裁剪叠加图。"
      },
      "cropTargetIndex": {
        "title": "裁剪目标序号（从 1 开始）",
        "type": "integer",
        "minimum": 1,
        "default": 1,
        "xEnabledWhen": {
          "outputCrop": [
            true
          ]
        },
        "description": "按类别过滤、置信度筛选和 NMS 后的有效检测框排序：置信度从高到低，第 1 个最高；同分保留后端顺序。序号仅属于当前图像，超出数量时按“无裁剪目标时”处理。",
        "xVisibleWhen": {
          "outputCrop": [
            true
          ]
        },
        "xValidateWhen": {
          "outputCrop": [
            true
          ]
        }
      },
      "onMissingCrop": {
        "title": "无裁剪目标时",
        "type": "string",
        "enum": ["error", "skip"],
        "default": "error",
        "xOptionLabels": {
          "error": "报错停止",
          "skip": "跳过裁剪，继续检测"
        },
        "xEnabledWhen": {"outputCrop": [true]},
        "description": "跳过时保留检测集合和叠加图，不生成裁剪图；依赖裁剪图的后续节点跳过本次执行。模型、参数和推理错误仍然报错。",
        "xVisibleWhen": {"outputCrop": [true]},
        "xValidateWhen": {"outputCrop": [true]}
      }
    },
    "required": [
      "modelPath"
    ],
    "xModeOperator": "vision.inference.yolo"
  },
  "minCoreVersion": "0.2.0",
  "maxCoreVersion": "1.x"
}
