{
  "operatorId": "vision.inference.yolo",
  "displayName": "YOLO Inference",
  "version": "1.2.1",
  "entry": "emo_master.plugins.builtins.yolo_inference.operator:YoloInferenceOperator",
  "category": "推理",
  "iconKey": "yolo",
  "iconResource": "assets/icon.svg",
  "summary": "使用 ONNX Runtime CPU 执行 YOLOv8/YOLO11 目标检测，输出标准 DetectionCollection。",
  "inputPorts": {
    "image": {
      "type": "image",
      "required": true,
      "nullable": false
    },
    "frame": {
      "type": "bbox2d",
      "required": false,
      "nullable": false,
      "schemaVersion": "1.x"
    }
  },
  "outputPorts": {
    "detections": {
      "type": "detectionCollection",
      "required": true,
      "schemaVersion": "1.x"
    },
    "overlay": {
      "type": "image",
      "required": false
    },
    "frame": {
      "type": "bbox2d",
      "required": true,
      "nullable": false,
      "schemaVersion": "1.x"
    }
  },
  "paramSchema": {
    "type": "object",
    "properties": {
      "modelPath": {
        "title": "模型路径",
        "type": "string",
        "default": "",
        "xWidget": "file",
        "xFileMode": "open",
        "xFilter": "YOLO ONNX 模型 (*.onnx)"
      },
      "confidence": {
        "title": "置信度阈值",
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0,
        "default": 0.25,
        "xExample": 0.25,
        "description": "保留置信度不低于此值的检测结果，范围为 0～1。"
      },
      "iou": {
        "title": "非极大值抑制 IoU 阈值",
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0,
        "default": 0.45,
        "xExample": 0.45,
        "description": "非极大值抑制的交并比阈值，范围为 0～1。"
      },
      "imageSize": {
        "title": "推理图像尺寸",
        "type": "integer",
        "minimum": 1,
        "default": 640,
        "xUnit": "像素",
        "xExample": 640,
        "description": "模型输入的目标图像尺寸，填写正整数。"
      },
      "maxDetections": {
        "title": "最大检测数量",
        "type": "integer",
        "minimum": 1,
        "default": 300,
        "xUnit": "个",
        "xExample": 300,
        "description": "单次推理最多保留的检测结果数量。"
      },
      "device": {
        "title": "推理设备",
        "type": "string",
        "enum": [
          "auto",
          "cpu"
        ],
        "default": "auto",
        "xOptionLabels": {
          "auto": "自动（当前使用 CPU）",
          "cpu": "CPU"
        },
        "description": "当前 ONNX 推理使用 CPU 执行提供程序。"
      },
      "classes": {
        "title": "检测类别（可选）",
        "description": "留空或 [] 表示检测模型支持的全部类别；填写 [0, 1] 等类别编号时仅保留指定类别。类别名称自动从模型读取。",
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "default": [],
        "xBlankMeansEmpty": true,
        "xExample": [
          0,
          1
        ]
      },
      "agnosticNms": {
        "title": "不区分类别的非极大值抑制",
        "type": "boolean",
        "default": false
      },
      "drawOverlay": {
        "title": "绘制叠加图",
        "type": "boolean",
        "default": false
      }
    },
    "required": [
      "modelPath"
    ]
  },
  "minCoreVersion": "0.2.0",
  "maxCoreVersion": "1.x"
}
