{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "navigate",
            "freeze",
            "resume_live",
            "history_previous",
            "history_next",
            "history_first"
          ],
          "title": "Type",
          "type": "string"
        },
        "pageId": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pageid"
        },
        "context": {
          "default": "live",
          "enum": [
            "live",
            "displayed_result"
          ],
          "title": "Context",
          "type": "string"
        },
        "resultScopeId": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resultscopeid"
        },
        "componentId": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Componentid"
        }
      },
      "required": [
        "type"
      ],
      "title": "Action",
      "type": "object"
    },
    "CallStep": {
      "additionalProperties": false,
      "properties": {
        "nodeId": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Nodeid",
          "type": "string"
        },
        "relation": {
          "default": "subflow",
          "enum": [
            "subflow",
            "loop_body",
            "loop_condition"
          ],
          "title": "Relation",
          "type": "string"
        }
      },
      "required": [
        "nodeId"
      ],
      "title": "CallStep",
      "type": "object"
    },
    "Collapse": {
      "additionalProperties": false,
      "properties": {
        "initiallyCollapsed": {
          "default": false,
          "title": "Initiallycollapsed",
          "type": "boolean"
        }
      },
      "title": "Collapse",
      "type": "object"
    },
    "Component": {
      "additionalProperties": false,
      "properties": {
        "componentId": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Componentid",
          "type": "string"
        },
        "type": {
          "enum": [
            "image",
            "text",
            "number",
            "indicator",
            "runtime_status",
            "table",
            "navigation_button",
            "container",
            "page_title",
            "page_navigation",
            "clock",
            "sqlite_table",
            "sqlite_value",
            "spacer"
          ],
          "title": "Type",
          "type": "string"
        },
        "version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Version",
          "type": "string"
        },
        "layout": {
          "$ref": "#/$defs/Placement"
        },
        "responsive": {
          "$ref": "#/$defs/ResponsiveItem"
        },
        "props": {
          "$ref": "#/$defs/Props"
        },
        "bindings": {
          "patternProperties": {
            "^\\S+$": {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 160,
            "minLength": 1
          },
          "title": "Bindings",
          "type": "object"
        },
        "actions": {
          "additionalProperties": {
            "$ref": "#/$defs/Action"
          },
          "propertyNames": {
            "const": "clicked"
          },
          "title": "Actions",
          "type": "object"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/Component"
          },
          "maxItems": 1024,
          "title": "Children",
          "type": "array"
        },
        "grid": {
          "anyOf": [
            {
              "$ref": "#/$defs/Grid"
            },
            {
              "$ref": "#/$defs/ResponsiveLayout"
            }
          ],
          "title": "Grid"
        }
      },
      "required": [
        "componentId",
        "type"
      ],
      "title": "Component",
      "type": "object"
    },
    "DataSource": {
      "additionalProperties": false,
      "description": "Value object: stores return detached copies; rebind replaces the reference.",
      "properties": {
        "kind": {
          "enum": [
            "node_output",
            "workflow_output",
            "global_counter",
            "global_variable",
            "runtime_status"
          ],
          "title": "Kind",
          "type": "string"
        },
        "resultScopeId": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Resultscopeid",
          "type": "string"
        },
        "workflowId": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflowid"
        },
        "callPath": {
          "items": {
            "$ref": "#/$defs/CallStep"
          },
          "maxItems": 32,
          "title": "Callpath",
          "type": "array"
        },
        "nodeId": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nodeid"
        },
        "port": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port"
        },
        "fieldPath": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Fieldpath",
          "type": "array"
        },
        "expectedType": {
          "enum": [
            "integer",
            "number",
            "string",
            "boolean",
            "image",
            "collection",
            "geometry",
            "json"
          ],
          "title": "Expectedtype",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "variableId": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variableid"
        },
        "ruleVersion": {
          "const": "1.0",
          "default": "1.0",
          "title": "Ruleversion",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "resultScopeId",
        "expectedType"
      ],
      "title": "DataSource",
      "type": "object"
    },
    "Grid": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "grid",
          "default": "grid",
          "title": "Type",
          "type": "string"
        },
        "columns": {
          "default": 1,
          "maximum": 24,
          "minimum": 1,
          "title": "Columns",
          "type": "integer"
        },
        "spacing": {
          "default": 8,
          "maximum": 128,
          "minimum": 0,
          "title": "Spacing",
          "type": "integer"
        }
      },
      "title": "Grid",
      "type": "object"
    },
    "HistoryView": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "table",
          "enum": [
            "table",
            "list"
          ],
          "title": "Mode",
          "type": "string"
        },
        "titleField": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Titlefield"
        },
        "subtitleField": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtitlefield"
        },
        "trailingField": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trailingfield"
        }
      },
      "title": "HistoryView",
      "type": "object"
    },
    "ImagePathSource": {
      "additionalProperties": false,
      "description": "A page-local filename, independent of Runtime result capture.",
      "properties": {
        "kind": {
          "enum": [
            "fixed",
            "selected_row"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "default": "",
          "maxLength": 4096,
          "title": "Path",
          "type": "string"
        },
        "componentId": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Componentid"
        },
        "field": {
          "default": "",
          "maxLength": 256,
          "title": "Field",
          "type": "string"
        },
        "baseDirectory": {
          "default": "",
          "maxLength": 4096,
          "title": "Basedirectory",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "enum": [
                "display_local",
                "runtime"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ImagePathSource",
      "type": "object"
    },
    "ImageView": {
      "additionalProperties": false,
      "properties": {
        "sizing": {
          "default": "aspect",
          "enum": [
            "fixed",
            "aspect"
          ],
          "title": "Sizing",
          "type": "string"
        },
        "aspectRatio": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aspectratio"
        },
        "background": {
          "default": "subtle",
          "enum": [
            "subtle",
            "dark",
            "transparent"
          ],
          "title": "Background",
          "type": "string"
        },
        "horizontalAlign": {
          "default": "center",
          "enum": [
            "start",
            "center",
            "end"
          ],
          "title": "Horizontalalign",
          "type": "string"
        },
        "verticalAlign": {
          "default": "center",
          "enum": [
            "start",
            "center",
            "end"
          ],
          "title": "Verticalalign",
          "type": "string"
        }
      },
      "title": "ImageView",
      "type": "object"
    },
    "IndicatorStyle": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 256,
          "title": "Text",
          "type": "string"
        },
        "color": {
          "default": "neutral",
          "enum": [
            "neutral",
            "green",
            "red",
            "amber",
            "blue"
          ],
          "title": "Color",
          "type": "string"
        },
        "background": {
          "default": "none",
          "enum": [
            "none",
            "soft"
          ],
          "title": "Background",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "IndicatorStyle",
      "type": "object"
    },
    "Navigation": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "tabs",
          "enum": [
            "tabs",
            "buttons"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "Navigation",
      "type": "object"
    },
    "Padding": {
      "additionalProperties": false,
      "properties": {
        "top": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top"
        },
        "right": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Right"
        },
        "bottom": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bottom"
        },
        "left": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Left"
        }
      },
      "title": "Padding",
      "type": "object"
    },
    "Page": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "layout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Grid"
            },
            {
              "$ref": "#/$defs/ResponsiveLayout"
            }
          ],
          "title": "Layout"
        },
        "canvasTop": {
          "default": 0,
          "maximum": 0,
          "minimum": -32768,
          "title": "Canvastop",
          "type": "integer"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/Component"
          },
          "maxItems": 1024,
          "title": "Components",
          "type": "array"
        },
        "resultScopeIds": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "title": "Resultscopeids",
          "type": "array"
        },
        "targets": {
          "default": [
            "desktop"
          ],
          "items": {
            "enum": [
              "desktop",
              "web"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Targets",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "Page",
      "type": "object"
    },
    "PageAppearance": {
      "additionalProperties": false,
      "properties": {
        "theme": {
          "const": "light",
          "default": "light",
          "title": "Theme",
          "type": "string"
        },
        "contentMaxWidth": {
          "default": 0,
          "maximum": 4096,
          "minimum": 0,
          "title": "Contentmaxwidth",
          "type": "integer"
        },
        "pagePadding": {
          "default": 24,
          "maximum": 64,
          "minimum": 0,
          "title": "Pagepadding",
          "type": "integer"
        }
      },
      "title": "PageAppearance",
      "type": "object"
    },
    "PageShell": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "default": "",
          "maxLength": 1024,
          "title": "Title",
          "type": "string"
        },
        "subtitle": {
          "default": "",
          "maxLength": 1024,
          "title": "Subtitle",
          "type": "string"
        },
        "logoResourceId": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logoresourceid"
        },
        "diagnosticsInitiallyExpanded": {
          "default": false,
          "title": "Diagnosticsinitiallyexpanded",
          "type": "boolean"
        },
        "showConnection": {
          "default": true,
          "title": "Showconnection",
          "type": "boolean"
        },
        "showJobState": {
          "default": true,
          "title": "Showjobstate",
          "type": "boolean"
        },
        "showControls": {
          "default": true,
          "title": "Showcontrols",
          "type": "boolean"
        }
      },
      "title": "PageShell",
      "type": "object"
    },
    "Placement": {
      "additionalProperties": false,
      "properties": {
        "row": {
          "default": 0,
          "maximum": 4095,
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        },
        "column": {
          "default": 0,
          "maximum": 23,
          "minimum": 0,
          "title": "Column",
          "type": "integer"
        },
        "rowSpan": {
          "default": 1,
          "maximum": 128,
          "minimum": 1,
          "title": "Rowspan",
          "type": "integer"
        },
        "columnSpan": {
          "default": 1,
          "maximum": 24,
          "minimum": 1,
          "title": "Columnspan",
          "type": "integer"
        }
      },
      "title": "Placement",
      "type": "object"
    },
    "Props": {
      "additionalProperties": false,
      "properties": {
        "spacerMode": {
          "default": "fixed",
          "enum": [
            "fixed",
            "flex"
          ],
          "title": "Spacermode",
          "type": "string"
        },
        "imageResourceId": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Imageresourceid"
        },
        "iconResourceId": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iconresourceid"
        },
        "title": {
          "default": "",
          "maxLength": 1024,
          "title": "Title",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 4096,
          "title": "Text",
          "type": "string"
        },
        "emptyText": {
          "default": "—",
          "maxLength": 256,
          "title": "Emptytext",
          "type": "string"
        },
        "unit": {
          "default": "",
          "maxLength": 64,
          "title": "Unit",
          "type": "string"
        },
        "decimals": {
          "default": 2,
          "maximum": 12,
          "minimum": 0,
          "title": "Decimals",
          "type": "integer"
        },
        "indicatorStates": {
          "additionalProperties": {
            "$ref": "#/$defs/IndicatorStyle"
          },
          "maxProperties": 16,
          "title": "Indicatorstates",
          "type": "object"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/TableColumn"
          },
          "maxItems": 16,
          "title": "Columns",
          "type": "array"
        },
        "pageSize": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Pagesize",
          "type": "integer"
        },
        "surface": {
          "anyOf": [
            {
              "$ref": "#/$defs/Surface"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "typography": {
          "anyOf": [
            {
              "$ref": "#/$defs/Typography"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "valueLayout": {
          "default": "vertical",
          "enum": [
            "vertical",
            "horizontal"
          ],
          "title": "Valuelayout",
          "type": "string"
        },
        "helperText": {
          "default": "",
          "maxLength": 1024,
          "title": "Helpertext",
          "type": "string"
        },
        "indicatorView": {
          "default": "text",
          "enum": [
            "text",
            "badge",
            "row"
          ],
          "title": "Indicatorview",
          "type": "string"
        },
        "showMarker": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Showmarker"
        },
        "imageView": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "buttonStyle": {
          "default": "secondary",
          "enum": [
            "primary",
            "secondary",
            "link"
          ],
          "title": "Buttonstyle",
          "type": "string"
        },
        "collapse": {
          "anyOf": [
            {
              "$ref": "#/$defs/Collapse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "statusField": {
          "anyOf": [
            {
              "enum": [
                "connection",
                "job_state"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statusfield"
        },
        "historyView": {
          "anyOf": [
            {
              "$ref": "#/$defs/HistoryView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "recordValue": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "field": "#/$defs/RecordField",
                  "meta": "#/$defs/RecordMeta"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/RecordField"
                },
                {
                  "$ref": "#/$defs/RecordMeta"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recordvalue"
        },
        "imagePath": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImagePathSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sqlite": {
          "$ref": "#/$defs/SqliteSource"
        }
      },
      "title": "Props",
      "type": "object"
    },
